import numpy as np
import matplotlib.pyplot as plt
import matplotlib.cm as cm
import imageio.v2 as imageio


rng = np.random.default_rng(7)

embed = rng.normal(size=(5, 3))
embed /= np.linalg.norm(
    embed,
    axis=1,
    keepdims=True
)

freq = np.array([
    1.0,
    1.3,
    0.7,
    1.8,
    1.1
])

phase_offsets = rng.uniform(
    0,
    2 * np.pi,
    size=5
)

def field(p, theta):
    r = p @ embed.T
    angles = theta * freq + phase_offsets

    return np.sum(
        (r ** 5)
        * np.cos(5 * angles),
        axis=-1
    )
def gradient(p, theta, eps=2e-3):
    grads = []

    for k in range(3):
        dp = np.zeros(3)
        dp[k] = eps
        f1 = field(
            p + dp,
            theta
        )
        f2 = field(
            p - dp,
            theta
        )
        grads.append(
            (f1 - f2)
            / (2 * eps)
        )
    return np.stack(
        grads,
        axis=-1
    )


def distance_estimate(
    p,
    theta,
    eps=2e-3
):
    f = field(
        p,
        theta
    )

    g = gradient(
        p,
        theta,
        eps
    )

    gradient_norm = np.maximum(
        np.linalg.norm(
            g,
            axis=-1
        ),
        1e-4
    )

    return f / gradient_norm





def ray_march(
    theta,
    W=220,
    H=220,
    max_steps=90,
    max_dist=10.0,
    cam_dist=4.5,
    fov=1.7
):
    xs = np.linspace(
        -fov,
        fov,
        W
    )
    ys = np.linspace(
        -fov,
        fov,
        H
    )
    xx, yy = np.meshgrid(
        xs,
        ys
    )
    cam = np.array([
        0.0,
        0.0,
        -cam_dist
    ])
    dirs = np.stack(
        [
            xx,
            yy,
            np.ones_like(xx)
        ],
        axis=-1
    )
    dirs /= np.linalg.norm(
        dirs,
        axis=-1,
        keepdims=True
    )
    dirs = dirs.reshape(
        -1,
        3
    )
    pos = np.tile(
        cam,
        (dirs.shape[0], 1)
    )
    active = np.ones(
        dirs.shape[0],
        dtype=bool
    )
    hit = np.zeros(
        dirs.shape[0],
        dtype=bool
    )
    traveled = np.zeros(
        dirs.shape[0]
    )
    steps_taken = np.zeros(
        dirs.shape[0]
    )
    for _ in range(max_steps):
        idx = np.where(active)[0]

        if len(idx) == 0:
            break

        d = distance_estimate(
            pos[idx],
            theta
        )
        step = np.clip(
            np.abs(d),
            1e-4,
            0.4
        )
        pos[idx] += (
            dirs[idx]
            * step[:, None]
        )
        traveled[idx] += step
        steps_taken[idx] += 1

        newly_hit = step < 2e-3

        hit[
            idx[newly_hit]
        ] = True
        active[
            idx[newly_hit]
        ] = False
        too_far = (
            traveled[idx]
            > max_dist
        )
        active[
            idx[too_far]
        ] = False
    return {
        "pos": pos,
        "dirs": dirs,
        "hit": hit,
        "traveled": traveled,
        "steps_taken": steps_taken,
        "W": W,
        "H": H,
        "max_steps": max_steps,
        "max_dist": max_dist
    }






def shade(
    march_result,
    theta,
    colormap="twilight_shifted"
):
    pos = march_result["pos"]
    dirs = march_result["dirs"]
    hit = march_result["hit"]

    traveled = march_result["traveled"]
    steps_taken = march_result["steps_taken"]

    W = march_result["W"]
    H = march_result["H"]
    max_steps = march_result["max_steps"]

    normals = gradient(
        pos,
        theta
    )
    normals /= np.maximum(
        np.linalg.norm(
            normals,
            axis=-1,
            keepdims=True
        ),
        1e-6
    )
    light_dir = np.array([
        0.5,
        0.8,
        -0.6
    ])
    light_dir /= np.linalg.norm(
        light_dir
    )
    diffuse = np.clip(
        np.sum(
            normals * light_dir,
            axis=-1
        ),
        0,
        1
    )

    view_dir = -dirs

    rim = np.clip(
        1.0
        - np.sum(
            normals * view_dir,
            axis=-1
        ),
        0,
        1
    ) ** 2

    hue = (
        steps_taken / max_steps
        + 0.15 * np.sin(theta)
    ) % 1.0

    base_color = cm.get_cmap(
        colormap
    )(hue)[:, :3]

    brightness = (
        0.25
        + 0.9 * diffuse
        + 0.5 * rim
    ) * hit.astype(float)
    img = np.clip(
        base_color
        * brightness[:, None],
        0,
        1.0
    )
    img[~hit] = np.array([
        0.02,
        0.02,
        0.05
    ])
    return img.reshape(
        H,
        W,
        3
    )


def render_frame(
    theta,
    **kwargs
):
    result = ray_march(
        theta,
        **kwargs
    )

    return shade(
        result,
        theta
    )



img = render_frame(
    theta=0.6,
    W=220,
    H=220,
    max_steps=90
)

plt.figure(
    figsize=(5, 5)
)

plt.imshow(img)
plt.axis("off")

plt.title(
    "Calabi-Yau Shadow"
)
plt.tight_layout()
plt.show()

n_frames = 48

W = 200
H = 200
max_steps = 90

thetas = np.linspace(
    0,
    2 * np.pi,
    n_frames,
    endpoint=False
)

frames = []

for theta in thetas:
    frame = (
        render_frame(
            theta,
            W=W,
            H=H,
            max_steps=max_steps
        )
        * 255
    ).astype(np.uint8)

    frames.append(frame)


gif_path = "calabi_yau_shadow.gif"

imageio.mimsave(
    gif_path,
    frames,
    fps=16,
    loop=0
)
