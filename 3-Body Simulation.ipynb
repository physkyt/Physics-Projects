import numpy as np
import torch
import torch.nn as nn
import torch.optim as optim
from scipy.integrate import solve_ivp
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation
from IPython.display import HTML

def three_body_equations(t, y, G=1.0, m1=1.0, m2=1.0, m3=1.0):
    r1, v1 = y[0:2], y[2:4]
    r2, v2 = y[4:6], y[6:8]
    r3, v3 = y[8:10], y[10:12]

    r12, r13, r23 = r2 - r1, r3 - r1, r3 - r2
    d12 = np.linalg.norm(r12) + 1e-5
    d13 = np.linalg.norm(r13) + 1e-5
    d23 = np.linalg.norm(r23) + 1e-5

    a1 = G * m2 * r12 / d12**3 + G * m3 * r13 / d13**3
    a2 = -G * m1 * r12 / d12**3 + G * m3 * r23 / d23**3
    a3 = -G * m1 * r13 / d13**3 - G * m2 * r23 / d23**3

    return [*v1, *a1, *v2, *a2, *v3, *a3]

def generate_data():
    r1 = np.array([-0.97000436, 0.24308753])
    r2 = -r1
    r3 = np.array([0.0, 0.0])
    v3 = np.array([-0.93240737, -0.86473146])
    v1 = -v3 / 2.0
    v2 = v1

    y0 = np.hstack([r1, v1, r2, v2, r3, v3])
    t_eval = np.linspace(0, 10, 400)
    solution = solve_ivp(three_body_equations, (0, 10), y0, t_eval=t_eval, rtol=1e-10)
    return solution.y.T

class ThreeBodyPredictor(nn.Module):
    def __init__(self):
        super().__init__()
        self.network = nn.Sequential(
            nn.Linear(12, 128),
            nn.Tanh(),
            nn.Linear(128, 128),
            nn.Tanh(),
            nn.Linear(128, 128),
            nn.Tanh(),
            nn.Linear(128, 12)
        )

    def forward(self, x):
        return self.network(x)

data = generate_data()
X = torch.tensor(data[:-1], dtype=torch.float32)
Y = torch.tensor(data[1:], dtype=torch.float32)

model = ThreeBodyPredictor()
criterion = nn.MSELoss()
optimizer = optim.Adam(model.parameters(), lr=0.001)

for epoch in range(800):
    optimizer.zero_grad()
    loss = criterion(model(X), Y)
    loss.backward()
    optimizer.step()

model.eval()
current_state = X[0].unsqueeze(0)
ml_trajectory = [X[0].numpy()]

with torch.no_grad():
    for _ in range(len(X)):
        next_state = model(current_state)
        ml_trajectory.append(next_state.squeeze(0).numpy())
        current_state = next_state

ml_trajectory = np.array(ml_trajectory)

fig, ax = plt.subplots(figsize=(6, 6))
ax.set_xlim(-1.5, 1.5)
ax.set_ylim(-1.5, 1.5)
ax.set_title("Machine Learning 3-Body Simulation")
ax.set_facecolor('#111111')

line1, = ax.plot([], [], 'cyan', label='Body 1', alpha=0.6, lw=1.5)
line2, = ax.plot([], [], 'magenta', label='Body 2', alpha=0.6, lw=1.5)
line3, = ax.plot([], [], 'yellow', label='Body 3', alpha=0.6, lw=1.5)

point1, = ax.plot([], [], 'co', markersize=8)
point2, = ax.plot([], [], 'mo', markersize=8)
point3, = ax.plot([], [], 'yo', markersize=8)
ax.legend(loc="upper right")

def init():
    return line1, line2, line3, point1, point2, point3

def update(frame):
    if frame == 0:
        return line1, line2, line3, point1, point2, point3

    line1.set_data(ml_trajectory[:frame, 0], ml_trajectory[:frame, 1])
    line2.set_data(ml_trajectory[:frame, 4], ml_trajectory[:frame, 5])
    line3.set_data(ml_trajectory[:frame, 8], ml_trajectory[:frame, 9])

    point1.set_data([ml_trajectory[frame-1, 0]], [ml_trajectory[frame-1, 1]])
    point2.set_data([ml_trajectory[frame-1, 4]], [ml_trajectory[frame-1, 5]])
    point3.set_data([ml_trajectory[frame-1, 8]], [ml_trajectory[frame-1, 9]])

    return line1, line2, line3, point1, point2, point3

ani = FuncAnimation(fig, update, frames=len(ml_trajectory), init_func=init, blit=False, interval=30)

plt.close(fig)

HTML(ani.to_jshtml())
