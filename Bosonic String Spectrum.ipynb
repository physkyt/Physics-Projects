import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from math import comb, log, sqrt, pi
from IPython.display import display


# —————————————————————————————————————————————————————————————
# SECTION 1
# Bosonic-string state counting
# —————————————————————————————————————————————————————————————

def bosonic_string_degeneracies(
    n_terms,
    n_transverse=24
):
    coeffs = [0] * n_terms
    coeffs[0] = 1

    for n in range(1, n_terms):
        j_max = (n_terms - 1) // n

        positions = [
            n * j
            for j in range(j_max + 1)
        ]

        factor_values = [
            comb(
                n_transverse + j - 1,
                j
            )
            for j in range(j_max + 1)
        ]
        new_coeffs = [0] * n_terms
        for i, coefficient in enumerate(coeffs):
            if coefficient == 0:
                continue

            for position, factor in zip(
                positions,
                factor_values
            ):
                if i + position >= n_terms:
                    break

                new_coeffs[
                    i + position
                ] += coefficient * factor

        coeffs = new_coeffs

    return coeffs

N_max = 250

d = bosonic_string_degeneracies(
    N_max + 1
)
assert d[1] == 24


# —————————————————————————————————————————————————————————————
# SECTION 2
# Physical mass spectrum
# —————————————————————————————————————————————————————————————

spectrum = pd.DataFrame([
    {
        "N": N,
        "mass_squared (alpha'=1)": N - 1,
        "degeneracy d(N)": d[N]
    }
    for N in range(8)
])

display(spectrum)


# —————————————————————————————————————————————————————————————
# SECTION 3
# Degeneracy growth
# —————————————————————————————————————————————————————————————

Ns = np.arange(
    10,
    N_max + 1
)
logd = np.array([
    log(d[N])
    for N in Ns
])
sqrtN = np.sqrt(Ns)
fig, ax = plt.subplots(
    figsize=(8, 6)
)
ax.plot(
    sqrtN,
    logd,
    ".",
    ms=3,
    label="exact log d(N), from the q-series"
)
ax.plot(
    sqrtN,
    4 * pi * sqrtN,
    "r--",
    label=r"theory: $4\pi\sqrt{N}$"
)
ax.set_xlabel(
    r"$\sqrt{N}$"
)
ax.set_ylabel(
    r"$\log d(N)$"
)
ax.set_title(
    "Bosonic-String Degeneracies vs. Predicted Hagedorn Growth Rate"
)
ax.legend()
plt.tight_layout()
plt.show()


# —————————————————————————————————————————————————————————————
# SECTION 4
# Fitting the asymptotic form
# —————————————————————————————————————————————————————————————

logN = np.log(Ns)

design = np.vstack([
    sqrtN,
    logN,
    np.ones(len(Ns))
]).T

A_fit, B_fit, C_fit = np.linalg.lstsq(
    design,
    logd,
    rcond=None
)[0]

residuals = (
    logd
    - design @ np.array([
        A_fit,
        B_fit,
        C_fit
    ])
)

fit_results = pd.DataFrame([
    {
        "quantity": "A",
        "value": A_fit,
        "theory": 4 * pi
    },
    {
        "quantity": "B",
        "value": B_fit,
        "theory": None
    },
    {
        "quantity": "C",
        "value": C_fit,
        "theory": None
    },
    {
        "quantity": "max_abs_residual",
        "value": np.max(
            np.abs(residuals)
        ),
        "theory": None
    }
])

display(fit_results)


# —————————————————————————————————————————————————————————————
# SECTION 5
# Hagedorn temperature
# —————————————————————————————————————————————————————————————

T_H_string_units = (
    1 / (4 * pi)
)

beta_H = 4 * pi

hagedorn_results = pd.DataFrame([
    {
        "quantity": "T_H",
        "value": T_H_string_units,
        "expression": "1/(4*pi*sqrt(alpha'))"
    },
    {
        "quantity": "beta_H",
        "value": beta_H,
        "expression": "4*pi*sqrt(alpha')"
    }
])

display(hagedorn_results)


# —————————————————————————————————————————————————————————————
# SECTION 6
# Degeneracy with leading Hagedorn growth comparison
# —————————————————————————————————————————————————————————————

N_check = 250

m_check = sqrt(
    N_check - 1
)
predicted = np.exp(
    m_check
    / T_H_string_units
)
growth_comparison = pd.DataFrame([
    {
        "quantity": "mass level N",
        "value": N_check
    },
    {
        "quantity": "mass in string units",
        "value": m_check
    },
    {
        "quantity": "log10 exact d(N)",
        "value": (
            log(
                float(d[N_check])
            )
            / log(10)
        )
    },
    {
        "quantity": "log10 exp(m/T_H)",
        "value": (
            log(predicted)
            / log(10)
        )
    }
])

display(growth_comparison)
