import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from scipy.signal import convolve
from scipy.optimize import curve_fit
from scipy.special import voigt_profile

# —————————————————————————————————————————————————————————————
# SECTION 1
# Simulated Z-Boson Spectrum
#
# Generate a smooth background and a Z-boson signal modeled with a relativistic Breit-Wigner distribution convolved with a Gaussian detector-resolution function.
# —————————————————————————————————————————————————————————————

np.random.seed(42)

num_events = 60000
num_signal = 12000

M0 = 91.1876
Gamma = 2.4952
sigma = 1.5

bg_mass = np.random.exponential(
    scale=30,
    size=num_events
) + 60

bg_mass = bg_mass[
    bg_mass <= 120
]

mass_grid = np.linspace(
    60,
    120,
    2000
)
dx = (
    mass_grid[1]
    - mass_grid[0]
)
bw_pdf = (
    mass_grid**2 * Gamma**2
) / (
    (mass_grid**2 - M0**2)**2
    + mass_grid**2 * Gamma**2
)

kernel_grid = np.arange(
    -15,
    15,
    dx
)

gauss_kernel = np.exp(
    -kernel_grid**2
    / (2 * sigma**2)
)

voigt_pdf = convolve(
    bw_pdf,
    gauss_kernel,
    mode="same"
)
voigt_pdf /= (
    np.sum(voigt_pdf)
    * dx
)

signal_mass = np.random.choice(
    mass_grid,
    size=num_signal,
    p=voigt_pdf * dx
)


simulated_masses = np.concatenate([
    bg_mass,
    signal_mass
])
simulated_data = pd.DataFrame({
    "M": simulated_masses
})

plt.figure(
    figsize=(10, 6)
)
plt.hist(
    simulated_data["M"],
    bins=120,
    range=(60, 120),
    color="#4F81BD",
    edgecolor="black",
    alpha=0.85,
    label="Simulated Data"
)
plt.axvline(
    x=M0,
    color="#C00000",
    linestyle="--",
    linewidth=2,
    label=f"Z Mass ({M0} GeV)"
)
plt.title(
    "Simulated Dimuon Invariant Mass Spectrum"
)
plt.xlabel(
    r"Invariant Mass $M$ [GeV/$c^2$]"
)
plt.ylabel(
    "Events / 0.5 GeV/$c^2$"
)
plt.xlim(
    60,
    120
)
plt.grid(
    axis="y",
    linestyle=":",
    alpha=0.6
)
plt.legend(
    loc="upper right"
)
plt.tight_layout()
plt.show()


# —————————————————————————————————————————————————————————————
# SECTION 2
# Experimental CMS Dimuon Data
#
# Loads the CMS dimuon dataset, reconstructs invariant mass directly from the measured four-momentum components, selects opposite-sign dimuon events, and fits the Z peak with a Voigt signal plus an exponential background.
# —————————————————————————————————————————————————————————————

url = (
    "https://raw.githubusercontent.com/"
    "particle-physics-playground/playground/"
    "master/data/dimuons.csv"
)

column_names = [
    "e1",
    "px1",
    "py1",
    "pz1",
    "q1",
    "e2",
    "px2",
    "py2",
    "pz2",
    "q2",
    "m"
]

df = pd.read_csv(
    url,
    names=column_names
)


E1 = df["e1"]
E2 = df["e2"]

px1 = df["px1"]
px2 = df["px2"]

py1 = df["py1"]
py2 = df["py2"]

pz1 = df["pz1"]
pz2 = df["pz2"]


total_E = E1 + E2
total_px = px1 + px2
total_py = py1 + py2
total_pz = pz1 + pz2

p_squared = (
    total_px**2
    + total_py**2
    + total_pz**2
)

calculated_mass = np.sqrt(
    total_E**2
    - p_squared
)

df["M_calculated"] = calculated_mass

real_z_bosons = df[
    (df["q1"] * df["q2"] == -1)
    & (df["M_calculated"] >= 60)
    & (df["M_calculated"] <= 120)
].copy()

lower_limit = 70.0
upper_limit = 110.0

fit_data = real_z_bosons[
    (real_z_bosons["M_calculated"] >= lower_limit)
    & (real_z_bosons["M_calculated"] <= upper_limit)
]["M_calculated"].values

bins = 80

counts, bin_edges = np.histogram(
    fit_data,
    bins=bins,
    range=(lower_limit, upper_limit)
)

bin_centers = (
    bin_edges[:-1]
    + bin_edges[1:]
) / 2.0

bin_width = (
    upper_limit - lower_limit
) / bins


errors = np.sqrt(
    counts
)

errors[errors == 0] = 1.0


def total_physics_model(
    mass,
    amplitude,
    mean,
    gamma,
    sigma,
    background_amplitude,
    background_decay
):
    signal = (
        amplitude
        * voigt_profile(
            mass - mean,
            sigma,
            gamma
        )
    )

    background = (
        background_amplitude
        * np.exp(
            -background_decay
            * (mass - lower_limit)
        )
    )

    return signal + background


initial_guesses = [
    5000,
    91.18,
    2.5,
    1.5,
    200,
    0.02
]

parameter_bounds = (
    [
        0,
        85.0,
        0.5,
        0.1,
        0,
        0
    ],
    [
        100000,
        95.0,
        5.0,
        4.0,
        5000,
        0.5
    ]
)


popt, pcov = curve_fit(
    total_physics_model,
    bin_centers,
    counts,
    p0=initial_guesses,
    bounds=parameter_bounds,
    sigma=errors,
    absolute_sigma=True
)


fit_amplitude = popt[0]
fit_mean = popt[1]
fit_gamma = popt[2]
fit_sigma = popt[3]
fit_background_amplitude = popt[4]
fit_background_decay = popt[5]

fit_errors = np.sqrt(
    np.diag(pcov)
)

fine_grid = np.linspace(
    lower_limit,
    upper_limit,
    500
)

total_fit = total_physics_model(
    fine_grid,
    *popt
)

background_fit = (
    fit_background_amplitude
    * np.exp(
        -fit_background_decay
        * (fine_grid - lower_limit)
    )
)


plt.figure(
    figsize=(10, 6)
)
plt.errorbar(
    bin_centers,
    counts,
    yerr=errors,
    fmt="o",
    color="black",
    markersize=4,
    elinewidth=1,
    capsize=1.5,
    label="CMS Public Data"
)
plt.plot(
    fine_grid,
    total_fit,
    color="#C00000",
    linewidth=2.5,
    label="Total Fit (Voigt + Background)"
)
plt.plot(
    fine_grid,
    background_fit,
    color="blue",
    linestyle="--",
    linewidth=1.5,
    label="Exponential Background"
)
plt.axvline(
    M0,
    color="black",
    linestyle=":",
    linewidth=1.5,
    label=f"Reference Z Mass ({M0} GeV)"
)
plt.title(
    "CMS Dimuon Invariant Mass Spectrum"
)
plt.xlabel(
    r"Invariant Mass $M_{\mu^+\mu^-}$ [GeV/$c^2$]"
)
plt.ylabel(
    f"Events / {bin_width:.1f} GeV/$c^2$"
)
plt.xlim(
    lower_limit,
    upper_limit
)
plt.grid(
    axis="y",
    linestyle=":",
    alpha=0.6
)
plt.legend(
    loc="upper right"
)
text_box = (
    f"Z mass = "
    f"{fit_mean:.3f} ± {fit_errors[1]:.3f} GeV\n"
    f"Width = "
    f"{fit_gamma:.3f} ± {fit_errors[2]:.3f} GeV\n"
    f"Resolution = "
    f"{fit_sigma:.3f} ± {fit_errors[3]:.3f} GeV"
)
plt.text(
    72,
    np.max(counts) * 0.75,
    text_box,
    fontsize=10,
    bbox={
        "facecolor": "white",
        "alpha": 0.8,
        "edgecolor": "gray"
    }
)
plt.tight_layout()
plt.show()
