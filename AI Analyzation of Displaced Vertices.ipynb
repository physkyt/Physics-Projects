import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.neural_network import MLPClassifier
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix


class AtlasVertexPipeline:

    def __init__(self, random_seed=42):
        self.seed = random_seed
        self.scaler = StandardScaler()
        self.model = MLPClassifier(
            hidden_layer_sizes=(32, 16),
            activation="relu",
            max_iter=1000,
            random_state=self.seed
        )
        np.random.seed(self.seed)

    def generate_synthetic_detector_event(self):
        hits_x = []
        hits_y = []
        labels = []

        vertex_x = 1.5
        vertex_y = 2.0
        num_tracks = 4
        hits_per_track = 8

        for _ in range(num_tracks):
            angle = np.random.uniform(0, 2 * np.pi)
            steps = np.linspace(0, 3, hits_per_track)

            for step in steps:
                x = vertex_x + step * np.cos(angle) + np.random.normal(0, 0.03)
                y = vertex_y + step * np.sin(angle) + np.random.normal(0, 0.03)

                hits_x.append(x)
                hits_y.append(y)
                labels.append(1)

        for _ in range(120):
            hits_x.append(np.random.uniform(-5, 5))
            hits_y.append(np.random.uniform(-5, 5))
            labels.append(0)

        return pd.DataFrame({
            "X": hits_x,
            "Y": hits_y,
            "IsTrack": labels
        })

    @staticmethod
    def extract_hough_features(x, y):
        angles = np.deg2rad(np.arange(-90, 90, 5))
        rhos = x * np.cos(angles) + y * np.sin(angles)

        return [
            np.mean(rhos),
            np.std(rhos),
            np.max(rhos),
            np.min(rhos)
        ]

    def run_pipeline(self):
        df = self.generate_synthetic_detector_event()

        features = np.array([
            self.extract_hough_features(row.X, row.Y)
            for _, row in df.iterrows()
        ])

        y_true = df["IsTrack"].values
        X_scaled = self.scaler.fit_transform(features)

        self.model.fit(X_scaled, y_true)
        y_pred = self.model.predict(X_scaled)

        accuracy = accuracy_score(y_true, y_pred)

        print(f"Accuracy: {accuracy:.2%}")
        print("\nConfusion matrix:")
        print(confusion_matrix(y_true, y_pred))
        print("\nClassification report:")
        print(
            classification_report(
                y_true,
                y_pred,
                target_names=["Background", "Track"]
            )
        )

        self.plot_results(df, y_pred)

    def plot_results(self, df, predictions):
        fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))

        background = df["IsTrack"] == 0
        tracks = df["IsTrack"] == 1

        ax1.scatter(
            df.loc[background, "X"],
            df.loc[background, "Y"],
            color="lightgray",
            marker=".",
            label="Background"
        )

        ax1.scatter(
            df.loc[tracks, "X"],
            df.loc[tracks, "Y"],
            color="blue",
            marker="o",
            s=50,
            label="Tracks"
        )

        ax1.axhline(0, color="black", linestyle=":", alpha=0.5)
        ax1.axvline(0, color="black", linestyle=":", alpha=0.5)
        ax1.set_title("Raw Detector Event")
        ax1.set_xlabel("X")
        ax1.set_ylabel("Y")
        ax1.legend()
        ax1.grid(True, alpha=0.3)

        background_pred = predictions == 0
        tracks_pred = predictions == 1

        ax2.scatter(
            df.loc[background_pred, "X"],
            df.loc[background_pred, "Y"],
            color="whitesmoke",
            edgecolors="gainsboro",
            marker=".",
            label="Rejected"
        )

        ax2.scatter(
            df.loc[tracks_pred, "X"],
            df.loc[tracks_pred, "Y"],
            color="crimson",
            marker="^",
            s=60,
            label="Predicted Tracks"
        )

        ax2.plot(
            1.5,
            2.0,
            marker="x",
            color="black",
            markersize=12,
            markeredgewidth=3,
            label="Vertex"
        )

        ax2.axhline(0, color="black", linestyle=":", alpha=0.5)
        ax2.axvline(0, color="black", linestyle=":", alpha=0.5)
        ax2.set_title("Hough + Neural Network Output")
        ax2.set_xlabel("X")
        ax2.set_ylabel("Y")
        ax2.legend()
        ax2.grid(True, alpha=0.3)

        plt.tight_layout()
        plt.savefig("detector_vertex_reconstruction.png", dpi=300)
        plt.show()


if __name__ == "__main__":
    pipeline = AtlasVertexPipeline()
    pipeline.run_pipeline()
