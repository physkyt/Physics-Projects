import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.neural_network import MLPClassifier
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import accuracy_score, classification_report


# —————————————————————————————————————————————————————————————
# SECTION 1
# Displaced Vertex Simulation
#
# Simulates detector hits produced by several tracks starting from an off-center vertex, adds background hits, extracts Hough-transform features, and classifies the hits with an MLP.
#
# —————————————————————————————————————————————————————————————

class AtlasVertexPipeline:

    def __init__(self, random_seed=42):
        self.seed = random_seed
        self.scaler = StandardScaler()
        self.model = MLPClassifier(
            hidden_layer_sizes=(32, 16),
            activation="relu",
            max_iter=1000,
            random_state=self.seed
        )
        np.random.seed(self.seed)

    def generate_synthetic_detector_event(self):
        hits_x = []
        hits_y = []
        labels = []

        vertex_x = 1.5
        vertex_y = 2.0
        num_tracks = 4
        hits_per_track = 8

        for _ in range(num_tracks):
            angle = np.random.uniform(0, 2 * np.pi)
            steps = np.linspace(0, 3, hits_per_track)

            for step in steps:
                x = vertex_x + step * np.cos(angle) + np.random.normal(0, 0.03)
                y = vertex_y + step * np.sin(angle) + np.random.normal(0, 0.03)

                hits_x.append(x)
                hits_y.append(y)
                labels.append(1)

        for _ in range(120):
            hits_x.append(np.random.uniform(-5, 5))
            hits_y.append(np.random.uniform(-5, 5))
            labels.append(0)

        return pd.DataFrame({
            "X": hits_x,
            "Y": hits_y,
            "IsTrack": labels
        })

    @staticmethod
    def extract_hough_features(x, y):
        angles = np.deg2rad(np.arange(-90, 90, 5))
        rhos = x * np.cos(angles) + y * np.sin(angles)

        return [
            np.mean(rhos),
            np.std(rhos),
            np.max(rhos),
            np.min(rhos)
        ]

    def run(self):
        df = self.generate_synthetic_detector_event()

        features = np.array([
            self.extract_hough_features(row.X, row.Y)
            for _, row in df.iterrows()
        ])

        target = df["IsTrack"].values

        features_scaled = self.scaler.fit_transform(features)

        self.model.fit(features_scaled, target)
        predictions = self.model.predict(features_scaled)

        print("SECTION 1: DISPLACED VERTEX SIMULATION")
        print(f"Accuracy: {accuracy_score(target, predictions):.2%}")
        print("\nClassification report:")
        print(
            classification_report(
                target,
                predictions,
                target_names=["Background", "Tracks"]
            )
        )

        self.plot_results(df, predictions)

    def plot_results(self, df, predictions):
        fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))

        background = df["IsTrack"] == 0
        tracks = df["IsTrack"] == 1

        ax1.scatter(
            df.loc[background, "X"],
            df.loc[background, "Y"],
            color="lightgray",
            marker=".",
            label="Background"
        )

        ax1.scatter(
            df.loc[tracks, "X"],
            df.loc[tracks, "Y"],
            color="blue",
            marker="o",
            s=50,
            label="Tracks"
        )

        ax1.axhline(0, color="black", linestyle=":", alpha=0.5)
        ax1.axvline(0, color="black", linestyle=":", alpha=0.5)

        ax1.set_title("Simulated Detector Event")
        ax1.set_xlabel("X")
        ax1.set_ylabel("Y")
        ax1.legend()
        ax1.grid(True, alpha=0.3)

        predicted_background = predictions == 0
        predicted_tracks = predictions == 1

        ax2.scatter(
            df.loc[predicted_background, "X"],
            df.loc[predicted_background, "Y"],
            color="whitesmoke",
            edgecolors="gainsboro",
            marker=".",
            label="Rejected"
        )

        ax2.scatter(
            df.loc[predicted_tracks, "X"],
            df.loc[predicted_tracks, "Y"],
            color="crimson",
            marker="^",
            s=60,
            label="Predicted Tracks"
        )

        ax2.plot(
            1.5,
            2.0,
            marker="x",
            color="black",
            markersize=12,
            markeredgewidth=3,
            label="Vertex"
        )

        ax2.axhline(0, color="black", linestyle=":", alpha=0.5)
        ax2.axvline(0, color="black", linestyle=":", alpha=0.5)

        ax2.set_title("Hough + Neural Network")
        ax2.set_xlabel("X")
        ax2.set_ylabel("Y")
        ax2.legend()
        ax2.grid(True, alpha=0.3)

        plt.tight_layout()
        plt.savefig("detector_vertex_reconstruction.png", dpi=300)
        plt.show()


# —————————————————————————————————————————————————————————————
# SECTION 2
# Momentum-Space Simulation
#
# Generates simulated signal and background track momenta, converts them to Px and Py and applies the same Hough-feature approach, and classifies the resulting tracks with an MLP.
#
# —————————————————————————————————————————————————————————————

def run_momentum_simulation():

    np.random.seed(42)

    sample_size = 2000

    pts_signal = (
        np.random.exponential(
            scale=45.0,
            size=sample_size // 2
        ) + 20.0
    )

    phi_signal = np.random.uniform(
        -np.pi,
        np.pi,
        size=sample_size // 2
    )

    pts_background = (
        np.random.exponential(
            scale=15.0,
            size=sample_size // 2
        ) + 5.0
    )

    phi_background = np.random.uniform(
        -np.pi,
        np.pi,
        size=sample_size // 2
    )

    pts = np.concatenate([pts_signal, pts_background])
    phis = np.concatenate([phi_signal, phi_background])

    labels = np.concatenate([
        np.zeros(sample_size // 2),
        np.ones(sample_size // 2)
    ])

    px = pts * np.cos(phis)
    py = pts * np.sin(phis)

    df = pd.DataFrame({
        "X": px,
        "Y": py,
        "IsBackground": labels
    })

    def extract_hough_features(x, y):
        angles = np.deg2rad(np.arange(-90, 90, 15))
        rhos = x * np.cos(angles) + y * np.sin(angles)

        return [
            np.mean(rhos),
            np.std(rhos),
            np.max(rhos),
            np.min(rhos)
        ]

    features = np.array([
        extract_hough_features(row.X, row.Y)
        for _, row in df.iterrows()
    ])

    target = df["IsBackground"].values

    scaler = StandardScaler()
    features_scaled = scaler.fit_transform(features)

    classifier = MLPClassifier(
        hidden_layer_sizes=(32, 16),
        activation="relu",
        max_iter=1000,
        random_state=42
    )

    classifier.fit(features_scaled, target)

    predictions = classifier.predict(features_scaled)

    print("\nSECTION 2: MOMENTUM-SPACE SIMULATION")
    print(f"Accuracy: {accuracy_score(target, predictions):.2%}")
    print("\nClassification report:")
    print(
        classification_report(
            target,
            predictions,
            target_names=["Signal", "Background"]
        )
    )

    plt.figure(figsize=(12, 5))

    plt.subplot(1, 2, 1)

    signal = df["IsBackground"] == 0
    background = df["IsBackground"] == 1

    plt.scatter(
        df.loc[signal, "X"],
        df.loc[signal, "Y"],
        color="royalblue",
        alpha=0.6,
        label="Signal"
    )

    plt.scatter(
        df.loc[background, "X"],
        df.loc[background, "Y"],
        color="darkgray",
        alpha=0.3,
        label="Background"
    )

    plt.title("Simulated Momentum Inputs")
    plt.xlabel("Momentum Px (GeV)")
    plt.ylabel("Momentum Py (GeV)")
    plt.legend()
    plt.grid(True, alpha=0.2)

    plt.subplot(1, 2, 2)

    predicted_signal = predictions == 0
    predicted_background = predictions == 1

    plt.scatter(
        df.loc[predicted_signal, "X"],
        df.loc[predicted_signal, "Y"],
        color="royalblue",
        alpha=0.2,
        label="Retained Signal"
    )

    plt.scatter(
        df.loc[predicted_background, "X"],
        df.loc[predicted_background, "Y"],
        color="crimson",
        marker="x",
        alpha=0.6,
        label="Background"
    )

    plt.title("Hough + Neural Network")
    plt.xlabel("Momentum Px (GeV)")
    plt.ylabel("Momentum Py (GeV)")
    plt.legend()
    plt.grid(True, alpha=0.2)

    plt.tight_layout()
    plt.savefig("momentum_simulation_output.png", dpi=300)
    plt.show()


# ============================================================
# Run both sections
# ============================================================

if __name__ == "__main__":
    vertex_pipeline = AtlasVertexPipeline()
    vertex_pipeline.run()

    run_momentum_simulation()
