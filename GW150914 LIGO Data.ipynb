import numpy as np
import h5py
import requests
import pandas as pd
import matplotlib.pyplot as plt

from scipy import signal
from scipy.interpolate import interp1d
from scipy.signal import butter, filtfilt


# —————————————————————————————————————————————————————————————
# SECTION 1
# Download GW150914 data
—————————————————————————————————————————————————————————————

def download(url, path):
    response = requests.get(url, timeout=60)
    response.raise_for_status()

    with open(path, "wb") as file:
        file.write(response.content)

    return path


h1_url = (
    "https://gwosc.org/GW150914data/"
    "H-H1_LOSC_4_V2-1126259446-32.hdf5"
)

l1_url = (
    "https://gwosc.org/GW150914data/"
    "L-L1_LOSC_4_V2-1126259446-32.hdf5"
)

template_url = (
    "https://gwosc.org/GW150914data/"
    "GW150914_4_NR_waveform.txt"
)

fn_H1 = download(
    h1_url,
    "H1_GW150914.hdf5"
)

fn_L1 = download(
    l1_url,
    "L1_GW150914.hdf5"
)

fn_template = download(
    template_url,
    "GW150914_NR_template.txt"
)


# —————————————————————————————————————————————————————————————
# SECTION 2
# Load the strain data
# —————————————————————————————————————————————————————————————

def load_gwosc_hdf5(filename):
    with h5py.File(filename, "r") as file:
        strain = file["strain"]["Strain"][:]
        dt = file["strain"]["Strain"].attrs["Xspacing"]
        gps_start = file["meta"]["GPSstart"][()]

    return strain, dt, gps_start


strain_H1, dt, gps_start = load_gwosc_hdf5(
    fn_H1
)

strain_L1, _, _ = load_gwosc_hdf5(
    fn_L1
)

fs = 1.0 / dt
N = len(strain_H1)

time = gps_start + np.arange(N) * dt

tevent = 1126259462.423

NRtime, NR_H1 = np.genfromtxt(
    fn_template
).T

info = pd.DataFrame([
    {
        "detector": "H1",
        "samples": len(strain_H1),
        "sample_rate_Hz": fs,
        "gps_start": gps_start
    },
    {
        "detector": "L1",
        "samples": len(strain_L1),
        "sample_rate_Hz": fs,
        "gps_start": gps_start
    }
])

info

deltat = 5

idx = np.where(
    (time >= tevent - deltat) &
    (time < tevent + deltat)
)[0]

plt.figure(figsize=(10, 4))
plt.plot(
    time[idx] - tevent,
    strain_H1[idx],
    "r",
    label="H1 strain",
    lw=0.8
)
plt.plot(
    time[idx] - tevent,
    strain_L1[idx],
    "g",
    label="L1 strain",
    lw=0.8
)
plt.xlabel(
    f"time (s) since GPS {tevent}"
)
plt.ylabel("strain")
plt.legend(loc="lower right")
plt.title(
    "Raw LIGO strain near GW150914"
)
plt.tight_layout()
plt.show()

# —————————————————————————————————————————————————————————————
# SECTION 4
# Noise spectrum
# —————————————————————————————————————————————————————————————

freqs_psd, Pxx_H1 = signal.welch(
    strain_H1,
    fs=fs,
    nperseg=int(4 * fs)
)

_, Pxx_L1 = signal.welch(
    strain_L1,
    fs=fs,
    nperseg=int(4 * fs)
)

psd_H1 = interp1d(
    freqs_psd,
    Pxx_H1,
    bounds_error=False,
    fill_value=(
        Pxx_H1[0],
        Pxx_H1[-1]
    )
)

psd_L1 = interp1d(
    freqs_psd,
    Pxx_L1,
    bounds_error=False,
    fill_value=(
        Pxx_L1[0],
        Pxx_L1[-1]
    )
)

plt.figure(figsize=(9, 6))

plt.loglog(
    freqs_psd,
    np.sqrt(Pxx_H1),
    "r",
    label="H1 ASD"
)
plt.loglog(
    freqs_psd,
    np.sqrt(Pxx_L1),
    "g",
    label="L1 ASD"
)
plt.axis([
    10,
    2000,
    1e-24,
    1e-19
])
plt.grid(
    True,
    which="both",
    alpha=0.3
)
plt.xlabel("Frequency (Hz)")
plt.ylabel(
    "ASD (strain / sqrt(Hz))"
)

plt.title(
    "Advanced LIGO noise spectrum near GW150914"
)
plt.legend()
plt.tight_layout()
plt.show()


# —————————————————————————————————————————————————————————————
# SECTION 5
# The Whitening and bandpass filtering
# —————————————————————————————————————————————————————————————

def whiten(strain, psd_fn, dt):
    Nt = len(strain)

    freqs = np.fft.rfftfreq(
        Nt,
        dt
    )

    hf = np.fft.rfft(strain)

    white_hf = (
        hf
        / np.sqrt(
            psd_fn(freqs)
            / dt
            / 2.0
        )
    )

    return np.fft.irfft(
        white_hf,
        n=Nt
    )


strain_H1_w = whiten(
    strain_H1,
    psd_H1,
    dt
)

strain_L1_w = whiten(
    strain_L1,
    psd_L1,
    dt
)

bb, ab = butter(
    4,
    [
        35 * 2 / fs,
        350 * 2 / fs
    ],
    btype="band"
)

strain_H1_wbp = filtfilt(
    bb,
    ab,
    strain_H1_w
)
strain_L1_wbp = filtfilt(
    bb,
    ab,
    strain_L1_w
)
strain_L1_shifted = -np.roll(
    strain_L1_wbp,
    int(0.007 * fs)
)
NR_H1_whiten = whiten(
    NR_H1,
    psd_H1,
    dt
)

NR_H1_wbp = filtfilt(
    bb,
    ab,
    NR_H1_whiten
)

plt.figure(figsize=(10, 4))
plt.plot(
    time - tevent,
    strain_H1_wbp,
    "r",
    label="H1"
)
plt.plot(
    time - tevent,
    strain_L1_shifted,
    "g",
    label="L1"
)
plt.plot(
    NRtime + 0.002,
    NR_H1_wbp,
    "k",
    label="NR waveform template"
)
plt.xlim([
    -0.1,
    0.05
])
plt.ylim([
    -4,
    4
])
plt.xlabel(
    f"time (s) since GPS {tevent}"
)
plt.ylabel("whitened strain")
plt.legend(loc="lower left")

plt.title(
    "GW150914 after whitening and bandpass filtering"
)
plt.tight_layout()
plt.show()

# —————————————————————————————————————————————————————————————
# SECTION 6
# The Spectrogram
# —————————————————————————————————————————————————————————————

fig, axes = plt.subplots(
    1,
    2,
    figsize=(12, 4.5),
    sharey=True
)

for ax, strain_w, detector in [
    (axes[0], strain_H1_w, "H1"),
    (axes[1], strain_L1_w, "L1")
]:

    idxz = np.where(
        (time >= tevent - 1) &
        (time < tevent + 0.5)
    )[0]

    NFFT = int(fs / 16)
    NOVL = int(NFFT * 15 / 16)

    window = np.blackman(NFFT)

    ax.specgram(
        strain_w[idxz],
        NFFT=NFFT,
        Fs=fs,
        window=window,
        noverlap=NOVL,
        cmap="viridis",
        xextent=[
            -1,
            0.5
        ]
    )

    ax.set_xlim([
        -0.5,
        0.1
    ])
    ax.set_ylim([
        0,
        500
    ])
    ax.set_xlabel(
        f"time (s) since GPS {tevent}"
    )
    ax.set_title(
        f"{detector} whitened spectrogram"
    )
axes[0].set_ylabel(
    "Frequency (Hz)"
)
plt.tight_layout()
plt.show()

# —————————————————————————————————————————————————————————————
# SECTION 7
# Matched filtering
# —————————————————————————————————————————————————————————————

def matched_filter_snr(
    strain,
    template_1d,
    psd_fn,
    dt,
    fs
):
    N = len(strain)

    template_padded = np.zeros(N)

    template_padded[
        :len(template_1d)
    ] = template_1d

    merger_idx_in_template = int(
        np.argmax(
            np.abs(template_1d)
        )
    )

    dwindow = signal.windows.tukey(
        N,
        alpha=1.0 / 8
    )
    data_fft = (
        np.fft.fft(
            strain * dwindow
        )
        / fs
    )
    template_fft = (
        np.fft.fft(
            template_padded * dwindow
        )
        / fs
    )
    freqs_full = np.fft.fftfreq(
        N,
        dt
    )

    df = np.abs(
        freqs_full[1]
        - freqs_full[0]
    )

    power_vec = psd_fn(
        np.abs(freqs_full)
    )

    power_vec[0] = power_vec[1]

    optimal = (
        data_fft
        * np.conj(template_fft)
        / power_vec
    )
    optimal_time = (
        2
        * np.fft.ifft(optimal)
        * fs
    )
    sigmasq = (
        np.sum(
            template_fft
            * np.conj(template_fft)
            / power_vec
        ).real
        * df
    )
    sigma = np.sqrt(
        np.abs(sigmasq)
    )
    snr_complex = (
        optimal_time
        / sigma
    )

    snr_complex = np.roll(
        snr_complex,
        merger_idx_in_template
    )

    return np.abs(
        snr_complex
    )


results = {}

for detector, strain_data, psd_fn in [
    ("H1", strain_H1, psd_H1),
    ("L1", strain_L1, psd_L1)
]:

    SNR = matched_filter_snr(
        strain_data,
        NR_H1,
        psd_fn,
        dt,
        fs
    )

    peak_idx = int(
        np.argmax(SNR)
    )

    results[detector] = {
        "SNR": SNR,
        "peak_idx": peak_idx,
        "peak_snr": SNR[peak_idx],
        "peak_time": time[peak_idx]
    }


# —————————————————————————————————————————————————————————————
# SECTION 8
# Matched-filter results
# —————————————————————————————————————————————————————————————

fig, axes = plt.subplots(
    2,
    1,
    figsize=(10, 7),
    sharex=True
)
for detector, color in [
    ("H1", "r"),
    ("L1", "g")
]:

    SNR = results[
        detector
    ]["SNR"]

    axes[0].plot(
        time - tevent,
        SNR,
        color,
        label=f"{detector} SNR(t)",
        lw=0.8
    )

    axes[1].plot(
        time - tevent,
        SNR,
        color,
        label=f"{detector} SNR(t)",
        lw=1.2
    )

axes[0].set_ylabel("SNR")
axes[0].set_title(
    "Matched-filter SNR across the full 32 s segment"
)
axes[0].legend()
axes[1].set_xlim([
    -0.2,
    0.1
])
axes[1].set_ylabel("SNR")
axes[1].set_xlabel(
    f"time (s) since GPS {tevent}"
)
axes[1].set_title(
    "Matched-filter SNR near the merger"
)
axes[1].legend()

plt.tight_layout()
plt.show()


# —————————————————————————————————————————————————————————————
# SECTION 9
# Results
# —————————————————————————————————————————————————————————————

summary = pd.DataFrame([
    {
        "detector": "H1",
        "our_peak_SNR":
            results["H1"]["peak_snr"],
        "our_peak_time_GPS":
            results["H1"]["peak_time"],
        "published_SNR": 20.0,
        "published_merger_GPS": tevent
    },
    {
        "detector": "L1",
        "our_peak_SNR":
            results["L1"]["peak_snr"],
        "our_peak_time_GPS":
            results["L1"]["peak_time"],
        "published_SNR": 13.0,
        "published_merger_GPS": tevent
    },
    {
        "detector": "combined (network)",
        "our_peak_SNR": np.sqrt(
            results["H1"]["peak_snr"] ** 2
            + results["L1"]["peak_snr"] ** 2
        ),
        "our_peak_time_GPS": np.nan,
        "published_SNR": 24.0,
        "published_merger_GPS": tevent
    }
])

summary[
    "time_offset_from_published_s"
] = (
    summary["our_peak_time_GPS"]
    - summary["published_merger_GPS"]
)

summary
