import numpy as np
import matplotlib.pyplot as plt

bin_centers = np.arange(
    0.0075,
    0.2475,
    0.005
)

dN_dt = np.array([
    4.12e5, 3.82e5, 3.54e5, 3.28e5, 3.03e5,
    2.76e5, 2.48e5, 2.22e5, 2.01e5, 1.81e5,
    1.63e5, 1.46e5, 1.31e5, 1.18e5, 1.06e5,
    9.49e4, 8.52e4, 7.65e4, 6.86e4, 6.16e4,
    5.52e4, 4.96e4, 4.45e4, 3.99e4, 3.58e4,
    3.21e4, 2.88e4, 2.58e4, 2.31e4, 2.07e4,
    1.85e4, 1.66e4, 1.49e4, 1.33e4, 1.20e4,
    1.07e4, 9.61e3, 8.62e3, 7.72e3, 6.92e3,
    6.20e3, 5.56e3, 4.98e3, 4.46e3, 4.00e3,
    3.58e3, 3.21e3, 2.88e3
])

bin_width = 0.005

counts = np.floor(
    dN_dt * bin_width
).astype(int)

y_errors = (
    np.sqrt(counts)
    / bin_width
)


# Fit the approximately exponential hadronic region
fit_mask = (
    (bin_centers > 0.02)
    & (bin_centers < 0.08)
)

t_fit = bin_centers[fit_mask]
log_dN_dt = np.log(dN_dt[fit_mask])

log_errors = (
    y_errors[fit_mask]
    / dN_dt[fit_mask]
)

weights = 1.0 / log_errors


(slope, intercept), covariance = np.polyfit(
    t_fit,
    log_dN_dt,
    1,
    w=weights,
    cov="unscaled"
)

slope_error = np.sqrt(
    covariance[0, 0]
)

B = -slope
N0 = np.exp(intercept)


# Calculate chi-squared in log space
predicted_log_dN_dt = (
    slope * t_fit
    + intercept
)

residuals = (
    log_dN_dt
    - predicted_log_dN_dt
)

chi2 = np.sum(
    (residuals / log_errors) ** 2
)

ndf = (
    len(t_fit)
    - 2
)

chi2_ndf = (
    chi2 / ndf
)


# Plot the spectrum and fitted exponential
t_continuous = np.linspace(
    0.005,
    0.25,
    200
)

fit_curve = (
    N0
    * np.exp(-B * t_continuous)
)


plt.figure(figsize=(9, 6))

plt.errorbar(
    bin_centers,
    dN_dt,
    yerr=y_errors,
    fmt="o",
    markersize=4,
    capsize=2,
    label="TOTEM reference spectrum"
)

plt.plot(
    t_continuous,
    fit_curve,
    linewidth=2,
    label=(
        f"Exponential fit "
        f"(B = {B:.2f} ± {slope_error:.2f} GeV$^{{-2}}$)"
    )
)

plt.yscale("log")
plt.title(
    "Proton-Proton Differential Elastic Cross-Section"
)
plt.xlabel(
    r"$|t|$ [GeV$^2$]"
)
plt.ylabel(
    r"$dN/dt$ [GeV$^{-2}$]"
)
plt.xlim(
    0.0,
    0.25
)
plt.ylim(
    1e3,
    np.max(dN_dt) * 2
)

plt.grid(
    True,
    which="both",
    linestyle=":",
    alpha=0.5
)
plt.legend()
plt.tight_layout()
plt.show()
