import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from scipy import stats
from scipy.special import gamma

pd.set_option(
    "display.float_format",
    lambda x: f"{x:.5g}"
)

# —————————————————————————————————————————————————————————————
# SECTION 1 
# Meson data
# —————————————————————————————————————————————————————————————

mesons_fit = pd.DataFrame([
    {
        "name": "rho(770)",
        "J": 1,
        "mass_GeV": 0.77526,
        "mass_unc_MeV": 0.23
    },
    {
        "name": "a2(1320)",
        "J": 2,
        "mass_GeV": 1.3182,
        "mass_unc_MeV": 0.6
    },
    {
        "name": "rho3(1690)",
        "J": 3,
        "mass_GeV": 1.6888,
        "mass_unc_MeV": 2.1
    },
    {
        "name": "a4(1970)",
        "J": 4,
        "mass_GeV": 1.967,
        "mass_unc_MeV": 16
    }
])

mesons_fit["mass2_GeV2"] = (
    mesons_fit["mass_GeV"] ** 2
)
mesons_test = pd.DataFrame([
    {
        "name": "rho5(2350)",
        "J": 5,
        "mass_GeV": 2.330
    },
    {
        "name": "f6(2510)",
        "J": 6,
        "mass_GeV": 2.510
    }
])
mesons_test["mass2_GeV2"] = (
    mesons_test["mass_GeV"] ** 2
)
mesons_fit


# —————————————————————————————————————————————————————————————
# SECTION 2
# Chew-Frautschi fit
# —————————————————————————————————————————————————————————————

fit = stats.linregress(
    mesons_fit["mass2_GeV2"],
    mesons_fit["J"]
)

alpha_prime = fit.slope
alpha0 = fit.intercept

fig, ax = plt.subplots(
    figsize=(7, 6)
)

mass_unc_GeV2 = (
    mesons_fit["mass_unc_MeV"]
    * 2
    * mesons_fit["mass_GeV"]
    / 1000
)

ax.errorbar(
    mesons_fit["mass2_GeV2"],
    mesons_fit["J"],
    xerr=mass_unc_GeV2,
    fmt="o",
    capsize=3,
    label="real PDG mesons (fit)"
)

xx = np.linspace(
    -0.5,
    7,
    100
)
ax.plot(
    xx,
    alpha0 + alpha_prime * xx,
    "k--",
    label=(
        f"fit: J = {alpha0:.2f} "
        f"+ {alpha_prime:.2f}" + r"$\cdot M^2$"
    )
)
ax.scatter(
    mesons_test["mass2_GeV2"],
    mesons_test["J"],
    marker="x",
    s=100,
    label="held-out real states",
    zorder=5
)

for _, row in mesons_fit.iterrows():
    ax.annotate(
        row["name"],
        (
            row["mass2_GeV2"],
            row["J"]
        ),
        textcoords="offset points",
        xytext=(8, -4),
        fontsize=8
    )
for _, row in mesons_test.iterrows():
    ax.annotate(
        row["name"],
        (
            row["mass2_GeV2"],
            row["J"]
        ),
        textcoords="offset points",
        xytext=(8, -4),
        fontsize=8
    )
ax.set_xlabel(
    r"mass$^2$ (GeV$^2$)"
)

ax.set_ylabel("spin J")
ax.set_title(
    "Chew-Frautschi plot: meson data"
)

ax.legend()
plt.tight_layout()
plt.show()


# —————————————————————————————————————————————————————————————
# SECTION 3
# Held-out trajectory prediction
# —————————————————————————————————————————————————————————————

predictions = []

for _, row in mesons_test.iterrows():
    predicted_mass2 = (
        row["J"] - alpha0
    ) / alpha_prime

    predicted_mass = np.sqrt(
        predicted_mass2
    )

    predictions.append({
        "name": row["name"],
        "J": row["J"],
        "predicted_mass_GeV": predicted_mass,
        "actual_mass_GeV": row["mass_GeV"],
        "difference_MeV": (
            predicted_mass
            - row["mass_GeV"]
        ) * 1000
    })

predictions = pd.DataFrame(
    predictions
)

predictions


# —————————————————————————————————————————————————————————————
# SECTION 4
# Nucleon and Delta trajectories
# —————————————————————————————————————————————————————————————

nucleon_traj = pd.DataFrame([
    {
        "name": "N(939)",
        "J": 0.5,
        "mass_GeV": 0.939
    },
    {
        "name": "N(1680)",
        "J": 2.5,
        "mass_GeV": 1.685
    },
    {
        "name": "N(2220)",
        "J": 4.5,
        "mass_GeV": 2.25
    }
])

delta_traj = pd.DataFrame([
    {
        "name": "Delta(1232)",
        "J": 1.5,
        "mass_GeV": 1.232
    },
    {
        "name": "Delta(1950)",
        "J": 3.5,
        "mass_GeV": 1.930
    },
    {
        "name": "Delta(2420)",
        "J": 5.5,
        "mass_GeV": 2.40
    }
])

for df in (
    nucleon_traj,
    delta_traj
):
    df["mass2_GeV2"] = (
        df["mass_GeV"] ** 2
    )


# —————————————————————————————————————————————————————————————
# SECTION 5
# Compare hadron trajectories
# —————————————————————————————————————————————————————————————

fig, ax = plt.subplots(
    figsize=(7, 6)
)
ax.scatter(
    mesons_fit["mass2_GeV2"],
    mesons_fit["J"],
    label=r"meson ($\rho$-$a$)"
)
ax.scatter(
    nucleon_traj["mass2_GeV2"],
    nucleon_traj["J"],
    marker="s",
    label="nucleon (N*)"
)
ax.scatter(
    delta_traj["mass2_GeV2"],
    delta_traj["J"],
    marker="^",
    label=r"$\Delta$"
)

trajectory_data = [
    (
        mesons_fit,
        "meson"
    ),
    (
        nucleon_traj,
        "N"
    ),
    (
        delta_traj,
        "Delta"
    )
]

for df, label in trajectory_data:
    trajectory_fit = stats.linregress(
        df["mass2_GeV2"],
        df["J"]
    )

    xx = np.linspace(
        0,
        7,
        50
    )

    ax.plot(
        xx,
        trajectory_fit.intercept
        + trajectory_fit.slope * xx,
        "--",
        alpha=0.6
    )
ax.set_xlabel(
    r"mass$^2$ (GeV$^2$)"
)
ax.set_ylabel("spin J")
ax.set_title(
    "Three independent hadron families, similar slopes"
)
ax.legend()
plt.tight_layout()
plt.show()


# —————————————————————————————————————————————————————————————
# SECTION 6
# Veneziano trajectory
# —————————————————————————————————————————————————————————————

def alpha(x):
    return (
        alpha0
        + alpha_prime * x
    )


def veneziano_amplitude(s, t):
    alpha_s = alpha(s)
    alpha_t = alpha(t)

    return (
        gamma(-alpha_s)
        * gamma(-alpha_t)
        / gamma(-alpha_s - alpha_t)
    )


# 7. Veneziano amplitude

t_fixed = -1.0

s_vals = np.linspace(
    0.1,
    7.0,
    8000
)

A_vals = np.array([
    veneziano_amplitude(
        s,
        t_fixed
    )
    for s in s_vals
])
A_vals_clipped = np.clip(
    A_vals,
    -60,
    60
)
fig, ax = plt.subplots(
    figsize=(10, 5)
)
ax.plot(
    s_vals,
    A_vals_clipped,
    lw=0.8
)

for _, row in mesons_fit.iterrows():
    ax.axvline(
        row["mass2_GeV2"],
        ls=":",
        alpha=0.6
    )

for _, row in mesons_test.iterrows():
    ax.axvline(
        row["mass2_GeV2"],
        ls=":",
        alpha=0.6
    )

ax.set_xlabel(
    r"$s$ (GeV$^2$)"
)
ax.set_ylabel(
    r"Veneziano amplitude $A(s,t=-1)$"
)

ax.set_title(
    "Veneziano amplitude and Regge trajectory poles"
)
plt.tight_layout()
plt.show()


# —————————————————————————————————————————————————————————————
# SECTION 7
# Predicted pole positions
# —————————————————————————————————————————————————————————————

all_mesons = pd.concat(
    [
        mesons_fit,
        mesons_test
    ],
    ignore_index=True
)

pole_results = []

for n in range(7):
    s_pole = (
        n - alpha0
    ) / alpha_prime

    mass_pole = np.sqrt(
        max(s_pole, 0)
    )

    matching_states = all_mesons[
        all_mesons["J"] == n
    ]

    if len(matching_states):
        state_name = (
            matching_states.iloc[0]["name"]
        )
    else:
        state_name = None

    pole_results.append({
        "n": n,
        "pole_s_GeV2": s_pole,
        "pole_mass_GeV": mass_pole,
        "matching_state": state_name
    })

pole_results = pd.DataFrame(
    pole_results
)

pole_results
