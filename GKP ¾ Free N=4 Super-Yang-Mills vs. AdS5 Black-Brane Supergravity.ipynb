import sympy as sp
import numpy as np
import matplotlib.pyplot as plt


pi = sp.pi

N, T, V, lam = sp.symbols(
    "N T V lambda",
    positive=True
)


# —————————————————————————————————————————————————————————————
# SECTION 1
# Free N=4 SYM degrees of freedom
# —————————————————————————————————————————————————————————————

n_B = 2 + 6
n_F = 4 * 2

g_star = (
    sp.Rational(n_B)
    + sp.Rational(7, 8) * sp.Rational(n_F)
)


# —————————————————————————————————————————————————————————————
# SECTION 2
# Free-field entropy and energy densities
# —————————————————————————————————————————————————————————————

S_free_over_NVT3 = sp.simplify(
    sp.Rational(2, 45)
    * pi**2
    * g_star
)

U_free_over_NVT4 = sp.simplify(
    sp.Rational(1, 30)
    * pi**2
    * g_star
)


# —————————————————————————————————————————————————————————————
# SECTION 3
# Conformal relation between free energy and entropy
# —————————————————————————————————————————————————————————————

F_free_via_U = sp.simplify(
    -U_free_over_NVT4 / 3
)

F_free_via_S = sp.simplify(
    -sp.Rational(1, 4)
    * S_free_over_NVT3
)

F_free_over_NVT4 = F_free_via_U


# —————————————————————————————————————————————————————————————
# SECTION 4
# Strong-coupling supergravity result
# —————————————————————————————————————————————————————————————

S_strong_over_NVT3 = sp.Rational(
    1,
    2
) * pi**2

F_strong_over_NVT4 = sp.simplify(
    -sp.Rational(1, 4)
    * S_strong_over_NVT3
)

ratio_S = sp.simplify(
    S_strong_over_NVT3
    / S_free_over_NVT3
)

ratio_F = sp.simplify(
    F_strong_over_NVT4
    / F_free_over_NVT4
)

results = {
    "n_B": n_B,
    "n_F": n_F,
    "g_star": g_star,
    "S_free/(N^2 V T^3)": S_free_over_NVT3,
    "U_free/(N^2 V T^4)": U_free_over_NVT4,
    "F_free/(N^2 V T^4)": F_free_over_NVT4,
    "S_strong/(N^2 V T^3)": S_strong_over_NVT3,
    "F_strong/(N^2 V T^4)": F_strong_over_NVT4,
    "S_strong/S_free": ratio_S,
    "F_strong/F_free": ratio_F
}

results

val_free = float(
    -F_free_over_NVT4
)

val_strong = float(
    -F_strong_over_NVT4
)

lam_vals = np.logspace(
    -2,
    3,
    200
)

schematic = (
    val_strong
    + (
        val_free
        - val_strong
    )
    / (
        1
        + (lam_vals / 2) ** 1.5
    )
)

fig, axes = plt.subplots(
    1,
    2,
    figsize=(12, 5)
)

axes[0].axhline(
    val_free,
    color="crimson",
    ls="-",
    lw=2,
    label=(
        r"exact: free theory "
        r"($\lambda=0$), $\pi^2/6$"
    )
)
axes[0].axhline(
    val_strong,
    color="navy",
    ls="-",
    lw=2,
    label=(
        r"exact: supergravity "
        r"($\lambda=\infty$), $\pi^2/8$"
    )
)
axes[0].plot(
    lam_vals,
    schematic,
    "k--",
    alpha=0.5,
    label=(
        "schematic interpolation only\n"
        "(not computed in this notebook)"
    )
)
axes[0].set_xscale("log")

axes[0].set_xlabel(
    r"'t Hooft coupling $\lambda=g_{YM}^2N$"
)
axes[0].set_ylabel(
    r"$-F/(N^2VT^4)$"
)
axes[0].set_title(
    "Free-energy coefficient: weak vs. strong coupling"
)
axes[0].legend(
    fontsize=8
)


values = [
    val_free,
    val_strong
]

labels = [
    "free\n(weak coupling)",
    "supergravity\n(strong coupling)"
]
axes[1].bar(
    labels,
    values,
    color=[
        "crimson",
        "navy"
    ]
)

for i, value in enumerate(values):
    axes[1].text(
        i,
        value + 0.03,
        f"{value:.4f}",
        ha="center"
    )

axes[1].set_ylabel(
    r"$-F/(N^2VT^4)$"
)
axes[1].set_title(
    f"Ratio = {float(ratio_F):.4f}"
)

plt.tight_layout()
plt.show()
