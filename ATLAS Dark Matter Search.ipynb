            (real_anomaly_scores >= threshold)
            & (y_real.values == 0)
        )

        if background_count > 0:
            significance = (
                signal_count
                / np.sqrt(background_count)
            )
        else:
            significance = 0.0

        real_significances.append(
            significance
        )

    best_idx = np.argmax(
        real_significances
    )

    real_best_threshold = thresholds[
        best_idx
    ]

    real_iso_predictions = (
        real_anomaly_scores
        >= real_best_threshold
    ).astype(int)

