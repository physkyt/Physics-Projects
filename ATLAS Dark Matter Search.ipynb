# —————————————————————————————————————————————————————————————
# This section uses ATLAS dark-matter search event data to train a neural-network classifier that distinguishes signal events from Standard Model background.
# The model uses five kinematic variables—missing transverse energy, dilepton invariant mass, leading- and subleading-lepton transverse momentum, and dilepton angular separation.
# It includes class-imbalance weighting, hyperparameter optimization, learning-rate decay, ROC/AUC evaluation, and an optimized classification threshold.
# —————————————————————————————————————————————————————————————



import os
import torch
import torch.nn as nn
import torch.optim as optim
from torch.utils.data import DataLoader, TensorDataset

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import (
    classification_report,
    roc_curve,
    roc_auc_score,
    confusion_matrix
)


background_files = [
    "ATLAS_DM_ML_notebook_WZ.csv",
    "ATLAS_DM_ML_notebook_ZZ.csv",
    "ATLAS_DM_ML_notebook_Z+jets.csv",
    "ATLAS_DM_ML_notebook_Non-resonant_ll.csv"
]

signal_files = [
    "ATLAS_DM_ML_notebook_DM_10.csv",
    "ATLAS_DM_ML_notebook_DM_100.csv",
    "ATLAS_DM_ML_notebook_DM_200.csv",
    "ATLAS_DM_ML_notebook_DM_300.csv",
    "ATLAS_DM_ML_notebook_DM_400.csv",
    "ATLAS_DM_ML_notebook_DM_500.csv",
    "ATLAS_DM_ML_notebook_DM_600.csv",
    "ATLAS_DM_ML_notebook_DM_700.csv",
    "ATLAS_DM_ML_notebook_DM_800.csv",
    "ATLAS_DM_ML_notebook_DM_2000.csv"
]

features = [
    "ETmiss",
    "mll",
    "lead_lep_pt",
    "sublead_lep_pt",
    "dRll"
]


bkg_list = []
sig_list = []

for f in background_files:
    if os.path.exists(f):
        bkg_list.append(pd.read_csv(f)[features])

for f in signal_files:
    if os.path.exists(f):
        sig_list.append(pd.read_csv(f)[features])


if not bkg_list or not sig_list:
    raise FileNotFoundError()


df_bkg = pd.concat(
    bkg_list,
    ignore_index=True
)

df_sig = pd.concat(
    sig_list,
    ignore_index=True
)

df_bkg["label"] = 0
df_sig["label"] = 1

df_all = pd.concat(
    [df_bkg, df_sig],
    ignore_index=True
)


X_raw = df_all[features].values
y_raw = df_all["label"].values

new_imbalance_ratio = len(df_bkg) / len(df_sig)


scaler = StandardScaler()
X_scaled = scaler.fit_transform(X_raw)


X_train, X_val, y_train, y_val = train_test_split(
    X_scaled,
    y_raw,
    test_size=0.2,
    random_state=42,
    stratify=y_raw
)


class ComprehensiveATLASClassifier(nn.Module):

    def __init__(self, input_dim, dropout_rate=0.3):
        super(ComprehensiveATLASClassifier, self).__init__()

        self.network = nn.Sequential(
            nn.Linear(input_dim, 128),
            nn.BatchNorm1d(128),
            nn.ReLU(),
            nn.Dropout(dropout_rate),

            nn.Linear(128, 64),
            nn.BatchNorm1d(64),
            nn.ReLU(),
            nn.Dropout(
                dropout_rate - 0.1
                if dropout_rate > 0.1
                else 0.0
            ),

            nn.Linear(64, 1)
        )

    def forward(self, x):
        return self.network(x)


pos_weight_tensor = torch.tensor(
    [new_imbalance_ratio],
    dtype=torch.float32
)

criterion = nn.BCEWithLogitsLoss(
    pos_weight=pos_weight_tensor
)


lr_grid = [0.001, 0.005]
dropout_grid = [0.2, 0.4]
batch_size_grid = [128, 256]

best_auc = 0.0
best_params = {}


for lr in lr_grid:
    for drop in dropout_grid:
        for batch_size in batch_size_grid:

            train_dataset = TensorDataset(
                torch.tensor(
                    X_train,
                    dtype=torch.float32
                ),
                torch.tensor(
                    y_train,
                    dtype=torch.float32
                )
            )

            train_loader = DataLoader(
                train_dataset,
                batch_size=batch_size,
                shuffle=True
            )

            model_nn = ComprehensiveATLASClassifier(
                input_dim=len(features),
                dropout_rate=drop
            )

            optimizer = optim.AdamW(
                model_nn.parameters(),
                lr=lr,
                weight_decay=1e-4
            )

            scheduler = optim.lr_scheduler.ExponentialLR(
                optimizer,
                gamma=0.90
            )

            model_nn.train()

            for epoch in range(1, 11):

                for batch_x, batch_y in train_loader:

                    optimizer.zero_grad()

                    outputs = model_nn(batch_x).squeeze()

                    loss = criterion(
                        outputs,
                        batch_y
                    )

                    loss.backward()
                    optimizer.step()

                scheduler.step()


            model_nn.eval()

            with torch.no_grad():

                val_inputs = torch.tensor(
                    X_val,
                    dtype=torch.float32
                )

                val_probabilities = torch.sigmoid(
                    model_nn(val_inputs).squeeze()
                ).numpy()


            current_auc = roc_auc_score(
                y_val,
                val_probabilities
            )


            if current_auc > best_auc:
                best_auc = current_auc

                best_params = {
                    "lr": lr,
                    "dropout": drop,
                    "batch_size": batch_size
                }


train_dataset = TensorDataset(
    torch.tensor(
        X_train,
        dtype=torch.float32
    ),
    torch.tensor(
        y_train,
        dtype=torch.float32
    )
)

train_loader = DataLoader(
    train_dataset,
    batch_size=best_params["batch_size"],
    shuffle=True
)


final_model = ComprehensiveATLASClassifier(
    input_dim=len(features),
    dropout_rate=best_params["dropout"]
)

optimizer = optim.AdamW(
    final_model.parameters(),
    lr=best_params["lr"],
    weight_decay=1e-4
)

scheduler = optim.lr_scheduler.ExponentialLR(
    optimizer,
    gamma=0.90
)


final_model.train()

for epoch in range(1, 21):

    epoch_loss = 0.0

    for batch_x, batch_y in train_loader:

        optimizer.zero_grad()

        outputs = final_model(batch_x).squeeze()

        loss = criterion(
            outputs,
            batch_y
        )

        loss.backward()
        optimizer.step()

        epoch_loss += (
            loss.item() * batch_x.size(0)
        )

    current_lr = scheduler.get_last_lr()[0]

    if epoch % 5 == 0 or epoch == 1:
        print(
            f"Epoch {epoch:02d}/20 | "
            f"Loss: {epoch_loss / len(X_train):.4f} | "
            f"LR: {current_lr:.5f}"
        )

    scheduler.step()


final_model.eval()

with torch.no_grad():

    val_inputs = torch.tensor(
        X_val,
        dtype=torch.float32
    )

    val_probabilities = torch.sigmoid(
        final_model(val_inputs).squeeze()
    ).numpy()


fpr, tpr, thresholds = roc_curve(
    y_val,
    val_probabilities
)

gmeans = np.sqrt(
    tpr * (1 - fpr)
)

best_idx = np.argmax(gmeans)

optimal_threshold = thresholds[best_idx]

y_pred_custom = (
    val_probabilities >= optimal_threshold
).astype(int)

nn_auc = roc_auc_score(
    y_val,
    val_probabilities
)


print(f"\nValidation ROC AUC: {nn_auc:.4f}")
print(f"Optimal threshold: {optimal_threshold:.4f}\n")

print(
    classification_report(
        y_val,
        y_pred_custom,
        target_names=[
            "Combined Background",
            "All Signals Included"
        ]
    )
)


fig, (ax1, ax2) = plt.subplots(
    1,
    2,
    figsize=(14, 5)
)


ax1.plot(
    fpr,
    tpr,
    color="darkviolet",
    lw=2.5,
    label=f"Unified Network (AUC = {nn_auc:.3f})"
)

ax1.scatter(
    fpr[best_idx],
    tpr[best_idx],
    color="black",
    s=120,
    zorder=5,
    label=f"Optimal Cut ({optimal_threshold:.2f})"
)

ax1.plot(
    [0, 1],
    [0, 1],
    color="navy",
    lw=2,
    linestyle="--"
)

ax1.set_xlabel(
    "False Positive Rate (Background Leakage)"
)

ax1.set_ylabel(
    "True Positive Rate (Signal Efficiency)"
)

ax1.set_title(
    "ATLAS Search: Comprehensive Network Profile"
)

ax1.legend(loc="lower right")
ax1.grid(True, alpha=0.3)


cm = confusion_matrix(
    y_val,
    y_pred_custom
)

sns.heatmap(
    cm,
    annot=True,
    fmt="d",
    cmap="Purples",
    cbar=False,
    ax=ax2,
    xticklabels=[
        "Predicted Background",
        "Predicted Signal"
    ],
    yticklabels=[
        "Actual Background",
        "Actual Signal"
    ]
)

ax2.set_ylabel("True Physics Class")
ax2.set_xlabel("Deep Learning Predicted Class")

ax2.set_title(
    "28k Unified ATLAS Event Array: Final Confusion Matrix"
)


plt.tight_layout()
plt.show()


final_checkpoint = {
    "model_state_dict": final_model.state_dict(),
    "optimal_threshold": optimal_threshold,
    "features_list": features,
    "scaler_mean": scaler.mean_,
    "scaler_var": scaler.var_
}

torch.save(
    final_checkpoint,
    "unified_atlas_mlp_weights.pth"
)
