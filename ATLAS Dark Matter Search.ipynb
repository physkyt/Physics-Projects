import os
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split, StratifiedKFold
from sklearn.ensemble import RandomForestClassifier, IsolationForest
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import (
    classification_report,
    roc_auc_score,
    roc_curve,
    confusion_matrix
)

try:
    from xgboost import XGBClassifier
    xgboost_available = True
except ImportError:
    xgboost_available = False

try:
    import torch
    import torch.nn as nn
    import torch.optim as optim
    from torch.utils.data import DataLoader, TensorDataset
    pytorch_available = True
except ImportError:
    pytorch_available = False


results = []


# —————————————————————————————————————————————————————————————
# SECTION 1
# Random Forest Baseline
#
# Uses the Monte Carlo-style simulated event sample as a classical machine-learning baseline.
# —————————————————————————————————————————————————————————————

np.random.seed(42)


def generate_mc_events(n_events=14000):
    background = pd.DataFrame({
        "met_et": np.random.rayleigh(
            scale=35,
            size=n_events
        ) + 15,

        "lept_pt": np.random.lognormal(
            mean=3.4,
            sigma=0.4,
            size=n_events
        ),

        "lept_eta": np.random.uniform(
            -2.5,
            2.5,
            size=n_events
        ),

        "lept_phi": np.random.uniform(
            -np.pi,
            np.pi,
            size=n_events
        ),

        "jet_n": np.random.poisson(
            lam=2.1,
            size=n_events
        ) + 1,

        "label": 0
    })

    signal = pd.DataFrame({
        "met_et": np.random.rayleigh(
            scale=95,
            size=n_events
        ) + 80,

        "lept_pt": np.random.lognormal(
            mean=3.8,
            sigma=0.5,
            size=n_events
        ),

        "lept_eta": np.random.uniform(
            -2.5,
            2.5,
            size=n_events
        ),

        "lept_phi": np.random.uniform(
            -np.pi,
            np.pi,
            size=n_events
        ),

        "jet_n": np.random.poisson(
            lam=1.2,
            size=n_events
        ) + 1,

        "label": 1
    })

    return pd.concat(
        [background, signal],
        ignore_index=True
    ).sample(
        frac=1,
        random_state=42
    ).reset_index(drop=True)


mc_df = generate_mc_events()

mc_features = [
    "met_et",
    "lept_pt",
    "lept_eta",
    "lept_phi",
    "jet_n"
]

X_mc = mc_df[mc_features]
y_mc = mc_df["label"]

X_train, X_val, y_train, y_val = train_test_split(
    X_mc,
    y_mc,
    test_size=0.2,
    random_state=42,
    stratify=y_mc
)


rf_model = RandomForestClassifier(
    n_estimators=150,
    max_depth=12,
    random_state=42,
    n_jobs=-1
)

rf_model.fit(X_train, y_train)

rf_probabilities = rf_model.predict_proba(
    X_val
)[:, 1]

rf_predictions = rf_model.predict(X_val)

rf_auc = roc_auc_score(
    y_val,
    rf_probabilities
)

print("\nSECTION 1: RANDOM FOREST")
print(f"ROC AUC: {rf_auc:.4f}")
print(
    classification_report(
        y_val,
        rf_predictions,
        target_names=[
            "Background",
            "Dark Matter"
        ]
    )
)

fpr_rf, tpr_rf, _ = roc_curve(
    y_val,
    rf_probabilities
)

plt.figure(figsize=(7, 5))

plt.plot(
    fpr_rf,
    tpr_rf,
    label=f"Random Forest (AUC = {rf_auc:.3f})"
)

plt.plot(
    [0, 1],
    [0, 1],
    linestyle="--"
)

plt.xlabel("False Positive Rate")
plt.ylabel("True Positive Rate")
plt.title("Monte Carlo Simulation: Random Forest")
plt.legend()
plt.grid(True, alpha=0.3)
plt.show()

results.append({
    "Dataset": "Monte Carlo simulation",
    "Method": "Random Forest",
    "Supervision": "Supervised",
    "ROC AUC": rf_auc
})

# —————————————————————————————————————————————————————————————
# SECTION 2
# Monte Carlo XGBoost
#
# Uses the simulated collision sample with 5-fold stratified cross-validation.
# —————————————————————————————————————————————————————————————

if xgboost_available:

    skf = StratifiedKFold(
        n_splits=5,
        shuffle=True,
        random_state=42
    )

    mc_auc_scores = []

    plt.figure(figsize=(8, 6))

    for fold, (train_idx, val_idx) in enumerate(
        skf.split(X_mc, y_mc),
        start=1
    ):

        X_train = X_mc.iloc[train_idx]
        X_val = X_mc.iloc[val_idx]

        y_train = y_mc.iloc[train_idx]
        y_val = y_mc.iloc[val_idx]

        model = XGBClassifier(
            n_estimators=180,
            max_depth=4,
            learning_rate=0.06,
            subsample=0.8,
            colsample_bytree=0.8,
            random_state=42,
            eval_metric="logloss"
        )

        model.fit(
            X_train,
            y_train
        )

        probabilities = model.predict_proba(
            X_val
        )[:, 1]

        fold_auc = roc_auc_score(
            y_val,
            probabilities
        )

        mc_auc_scores.append(
            fold_auc
        )

        fpr, tpr, _ = roc_curve(
            y_val,
            probabilities
        )

        plt.plot(
            fpr,
            tpr,
            alpha=0.4,
            linestyle="--",
            label=f"Fold {fold} (AUC = {fold_auc:.3f})"
        )
    mc_mean_auc = np.mean(
        mc_auc_scores
    )

    mc_std_auc = np.std(
        mc_auc_scores
    )

    print("\nSECTION 2: MONTE CARLO XGBOOST")
    print(
        f"Mean ROC AUC: "
        f"{mc_mean_auc:.4f} ± {mc_std_auc:.4f}"
    )

    plt.plot(
        [0, 1],
        [0, 1],
        linestyle="--"
    )
    plt.xlabel("False Positive Rate")
    plt.ylabel("True Positive Rate")
    plt.title(
        f"Monte Carlo XGBoost "
        f"(Mean AUC = {mc_mean_auc:.3f})"
    )
    plt.legend(
        loc="lower right"
    )
    plt.grid(
        True,
        alpha=0.3
    )
    plt.show()

    results.append({
        "Dataset": "Monte Carlo simulation",
        "Method": "XGBoost",
        "Supervision": "Supervised",
        "ROC AUC": mc_mean_auc
    })

else:
    print(
        "\nSECTION 2: MONTE CARLO XGBOOST"
        "\nSkipped because XGBoost is not installed."
    )


# —————————————————————————————————————————————————————————————
# SECTION 3
# Monte Carlo Isolation Forest
#
# Generates overlapping simulated signal/background data and trains only on the background sample.
# —————————————————————————————————————————————————————————————


def generate_anomaly_simulation(n_events=10000):

    background = pd.DataFrame({
        "met_et": np.random.rayleigh(
            scale=45,
            size=n_events
        ) + 20,

        "lept_pt": np.random.lognormal(
            mean=3.5,
            sigma=0.4,
            size=n_events
        ),

        "label": 0
    })

    signal_size = int(
        n_events * 0.15
    )

    signal = pd.DataFrame({
        "met_et": np.random.rayleigh(
            scale=65,
            size=signal_size
        ) + 45,

        "lept_pt": np.random.lognormal(
            mean=3.7,
            sigma=0.5,
            size=signal_size
        ),

        "label": 1
    })

    return (
        background,
        signal
    )


mc_background, mc_signal = (
    generate_anomaly_simulation()
)

anomaly_features = [
    "met_et",
    "lept_pt"
]

X_background = mc_background[
    anomaly_features
]

X_mixed = pd.concat(
    [
        mc_background.sample(
            frac=0.2,
            random_state=42
        ),
        mc_signal
    ],
    ignore_index=True
)

y_mixed = X_mixed["label"]

X_mixed_features = X_mixed[
    anomaly_features
]


iso_mc = IsolationForest(
    n_estimators=200,
    contamination=0.15,
    random_state=42
)

iso_mc.fit(
    X_background
)

anomaly_scores = -iso_mc.decision_function(
    X_mixed_features
)

iso_mc_auc = roc_auc_score(
    y_mixed,
    anomaly_scores
)

fpr_iso, tpr_iso, _ = roc_curve(
    y_mixed,
    anomaly_scores
)


thresholds = np.linspace(
    anomaly_scores.min(),
    anomaly_scores.max(),
    100
)

significances = []

for threshold in thresholds:

    signal_count = np.sum(
        (anomaly_scores >= threshold)
        & (y_mixed.values == 1)
    )

    background_count = np.sum(
        (anomaly_scores >= threshold)
        & (y_mixed.values == 0)
    )

    if background_count > 0:
        significance = (
            signal_count
            / np.sqrt(background_count)
        )
    else:
        significance = 0.0

    significances.append(
        significance
    )


best_idx = np.argmax(
    significances
)
best_threshold = thresholds[
    best_idx
]
best_significance = significances[
    best_idx
]
iso_mc_predictions = (
    anomaly_scores >= best_threshold
).astype(int)

print("\nSECTION 3: MONTE CARLO ISOLATION FOREST")
print(f"ROC AUC: {iso_mc_auc:.4f}")
print(
    f"Optimal threshold: "
    f"{best_threshold:.4f}"
)
print(
    f"S/sqrt(B): "
    f"{best_significance:.2f}"
)

fig, (ax1, ax2) = plt.subplots(
    1,
    2,
    figsize=(13, 5)
)
ax1.plot(
    fpr_iso,
    tpr_iso,
    color="forestgreen",
    lw=2,
    label=f"Isolation Forest (AUC = {iso_mc_auc:.3f})"
)
ax1.plot(
    [0, 1],
    [0, 1],
    linestyle="--"
)
ax1.set_xlabel(
    "False Positive Rate"
)
ax1.set_ylabel(
    "True Positive Rate"
)
ax1.set_title(
    "Monte Carlo Anomaly Search"
)
ax1.legend()
ax1.grid(
    True,
    alpha=0.3
)

mc_cm = confusion_matrix(
    y_mixed,
    iso_mc_predictions
)

sns.heatmap(
    mc_cm,
    annot=True,
    fmt="d",
    cmap="Greens",
    cbar=False,
    ax=ax2,
    xticklabels=[
        "Predicted Background",
        "Predicted Signal"
    ],
    yticklabels=[
        "Actual Background",
        "Actual Signal"
    ]
)

ax2.set_title(
    "Monte Carlo Anomaly Detection"
)

plt.tight_layout()
plt.show()


results.append({
    "Dataset": "Monte Carlo overlap simulation",
    "Method": "Isolation Forest",
    "Supervision": "Unsupervised",
    "ROC AUC": iso_mc_auc
})

# —————————————————————————————————————————————————————————————
# SECTION 4
# Local ATLAS CSV Isolation Forest
#
# Uses the local WZ background and DM_500 signal files. The model is trained only on the background sample.
# —————————————————————————————————————————————————————————————

real_bkg_file = (
    "ATLAS_DM_ML_notebook_WZ.csv"
)

