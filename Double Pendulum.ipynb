import numpy as np
import torch
import torch.nn as nn
import torch.optim as optim
from scipy.integrate import solve_ivp
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation
from IPython.display import HTML

def double_pendulum_equations(t, y, L1=1.0, L2=1.0, M1=1.0, M2=1.0, g=9.81):
    th1, w1, th2, w2 = y

    delta = th1 - th2

    den1 = L1 * (2 * M1 + M2 - M2 * np.cos(2 * th1 - 2 * th2))
    den2 = L2 * (2 * M1 + M2 - M2 * np.cos(2 * th1 - 2 * th2))

    alpha1 = (-g * (2 * M1 + M2) * np.sin(th1) - M2 * g * np.sin(th1 - 2 * th2) -
              2 * np.sin(delta) * M2 * (w2**2 * L2 + w1**2 * L1 * np.cos(delta))) / den1

    alpha2 = (2 * np.sin(delta) * (w1**2 * L1 * (M1 + M2) + g * (M1 + M2) * np.cos(th1) +
              w2**2 * L2 * M2 * np.cos(delta))) / den2

    return [w1, alpha1, w2, alpha2]

def generate_data():
    y0 = [np.pi / 2, 0.0, np.pi / 2, 0.0]

    t_eval = np.linspace(0, 10, 400)
    solution = solve_ivp(double_pendulum_equations, (0, 10), y0, t_eval=t_eval, rtol=1e-10)
    return solution.y.T

class DoublePendulumPredictor(nn.Module):
    def __init__(self):
        super().__init__()
        self.network = nn.Sequential(
            nn.Linear(4, 128),
            nn.Tanh(),
            nn.Linear(128, 128),
            nn.Tanh(),
            nn.Linear(128, 128),
            nn.Tanh(),
            nn.Linear(128, 4)
        )

    def forward(self, x):
        return self.network(x)

data = generate_data()
X = torch.tensor(data[:-1], dtype=torch.float32)
Y = torch.tensor(data[1:], dtype=torch.float32)

model = DoublePendulumPredictor()
criterion = nn.MSELoss()
optimizer = optim.Adam(model.parameters(), lr=0.001)

for epoch in range(1000):
    optimizer.zero_grad()
    loss = criterion(model(X), Y)
    loss.backward()
    optimizer.step()

model.eval()
current_state = X[0].unsqueeze(0)
ml_trajectory = [X[0].numpy()]

with torch.no_grad():
    for _ in range(len(X)):
        next_state = model(current_state)
        ml_trajectory.append(next_state.squeeze(0).numpy())
        current_state = next_state

ml_trajectory = np.array(ml_trajectory)

L1, L2 = 1.0, 1.0
th1_pred = ml_trajectory[:, 0]
th2_pred = ml_trajectory[:, 2]

x1 = L1 * np.sin(th1_pred)
y1 = -L1 * np.cos(th1_pred)

x2 = x1 + L2 * np.sin(th2_pred)
y2 = y1 - L2 * np.cos(th2_pred)

fig, ax = plt.subplots(figsize=(6, 6))
ax.set_xlim(-2.2, 2.2)
ax.set_ylim(-2.2, 2.2)
ax.set_title("Machine Learning Double Pendulum Simulation")
ax.set_facecolor('#111111')

trace, = ax.plot([], [], 'cyan', alpha=0.4, lw=1, label="Tip Path")
rod_lines, = ax.plot([], [], color='white', marker='o', markersize=6, lw=2, label="Pendulum")
ax.legend(loc="upper right")

def init():
    trace.set_data([], [])
    rod_lines.set_data([], [])
    return trace, rod_lines

def update(frame):
    if frame == 0:
        return trace, rod_lines

    trace.set_data(x2[:frame], y2[:frame])

    rod_x = [0, x1[frame-1], x2[frame-1]]
    rod_y = [0, y1[frame-1], y2[frame-1]]
    rod_lines.set_data(rod_x, rod_y)

    return trace, rod_lines

ani = FuncAnimation(fig, update, frames=len(ml_trajectory), init_func=init, blit=False, interval=25)
plt.close(fig)

HTML(ani.to_jshtml())
