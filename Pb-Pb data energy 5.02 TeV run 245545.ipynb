import os
import csv
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from scipy.optimize import curve_fit
from scipy.integrate import simpson
from scipy.special import ive, kve

# —————————————————————————————————————————————————————————————
# SECTION 1
# BLAST-WAVE MODEL
# —————————————————————————————————————————————————————————————

def stable_blast_wave_model(pt, N0, T_kin, beta_s, mass):
    pt = np.atleast_1d(pt)

    mt = np.sqrt(
        pt[:, np.newaxis] ** 2 + mass ** 2
    )
    r = np.linspace(
        0.0,
        1.0,
        50
    )
    beta_r = np.clip(
        beta_s * r,
        0.0,
        0.9999
    )

    rho = np.arctanh(beta_r)

    pt_2d = pt[:, np.newaxis]

    arg_I0 = (
        pt_2d * np.sinh(rho)
    ) / T_kin

    arg_K1 = (
        mt * np.cosh(rho)
    ) / T_kin

    bessel_product = (
        ive(0, arg_I0)
        * kve(1, arg_K1)
        * np.exp(arg_I0 - arg_K1)
    )

    integrand = (
        r
        * pt_2d
        * bessel_product
    )

    integral = simpson(
        integrand,
        x=r,
        axis=1
    )

    return N0 * integral


def global_blast_wave_fit(
    combined_pt,
    log_N0_pi,
    log_N0_pr,
    T_kin,
    beta_s
):
    midpoint = len(combined_pt) // 2

    pt_pions = combined_pt[:midpoint]
    pt_protons = combined_pt[midpoint:]

    pion_model = (
        np.exp(log_N0_pi)
        * stable_blast_wave_model(
            pt_pions,
            1.0,
            T_kin,
            beta_s,
            0.13957
        )
    )

    proton_model = (
        np.exp(log_N0_pr)
        * stable_blast_wave_model(
            pt_protons,
            1.0,
            T_kin,
            beta_s,
            0.93827
        )
    )

    return np.concatenate([
        np.log(pion_model + 1e-10),
        np.log(proton_model + 1e-10)
    ])

# —————————————————————————————————————————————————————————————
# SECTION 2
# ASSUMED EXPERIMENTAL ALICE SPECTRUM
# —————————————————————————————————————————————————————————————

assumed_bin_edges = np.arange(
    0.15,
    2.80,
    0.05
)

assumed_bin_centers = (
    assumed_bin_edges[:-1]
    + assumed_bin_edges[1:]
) / 2.0

assumed_dN_dpt = np.array([
    561331.4, 476103.5, 403816.1, 342504.4,
    290500.5, 246393.3, 208982.5, 177252.1,
    150339.6, 127513.1, 108152.4, 91731.5,
    77802.0, 65988.9, 55969.6, 47471.6,
    40263.9, 34150.6, 28965.5, 24567.6,
    20837.5, 17673.5, 14989.2, 12713.4,
    10783.1, 9145.8, 7757.0, 6579.3,
    5580.3, 4733.1, 4014.4, 3404.9,
    2887.9, 2449.4, 2077.5, 1762.1,
    1494.5, 1267.6, 1075.1, 911.9,
    773.4, 656.0, 556.4, 471.9,
    400.2, 339.5, 287.9, 244.2,
    207.1, 175.7, 149.0, 126.4
])

nominal_bin_width = 0.05

assumed_counts = np.floor(
    assumed_dN_dpt * nominal_bin_width
).astype(int)
assumed_stat_errors = (
    np.sqrt(assumed_counts)
    / nominal_bin_width
)
assumed_sys_errors = (
    0.0025 * assumed_dN_dpt
)
assumed_total_errors = np.sqrt(
    assumed_stat_errors ** 2
    + assumed_sys_errors ** 2
)
assumed_fit_mask = (
    (assumed_bin_centers > 0.3)
    & (assumed_bin_centers < 1.1)
)
assumed_fit_bounds = (
    (1e4, 0.050, 0.20),
    (1e8, 0.220, 0.90)
)
assumed_popt, assumed_pcov = curve_fit(
    lambda pt, N0, T_kin, beta_s:
        stable_blast_wave_model(
            pt,
            N0,
            T_kin,
            beta_s,
            0.13957
        ),
    assumed_bin_centers[assumed_fit_mask],
    assumed_dN_dpt[assumed_fit_mask],
    p0=[
        1.5e6,
        0.100,
        0.65
    ],
    sigma=assumed_total_errors[
        assumed_fit_mask
    ],
    bounds=assumed_fit_bounds,
    absolute_sigma=True
)

assumed_N0, assumed_T_kin, assumed_beta_s = (
    assumed_popt
)
assumed_parameter_errors = np.sqrt(
    np.diag(assumed_pcov)
)
assumed_y_pred = stable_blast_wave_model(
    assumed_bin_centers[assumed_fit_mask],
    *assumed_popt,
    mass=0.13957
)
assumed_residuals = (
    assumed_dN_dpt[assumed_fit_mask]
    - assumed_y_pred
) / assumed_total_errors[
    assumed_fit_mask
]
assumed_chi2 = np.sum(
    assumed_residuals ** 2
)
assumed_ndf = (
    np.sum(assumed_fit_mask)
    - len(assumed_popt)
)
assumed_chi2_ndf = (
    assumed_chi2 / assumed_ndf
)
assumed_avg_beta = (
    2.0 / 3.0
) * assumed_beta_s

# —————————————————————————————————————————————————————————————
# SECTION 3
# DUAL-SPECIES MONTE CARLO
# —————————————————————————————————————————————————————————————

np.random.seed(245545)

cern_T_target = 0.100
cern_beta_target = 0.65

m_pion = 0.13957
m_proton = 0.93827

total_pions = 5_000_000
total_protons = 1_000_000

bin_edges = np.arange(
    0.15,
    2.80,
    0.05
)

bin_centers = (
    bin_edges[:-1]
    + bin_edges[1:]
) / 2.0

bin_width = 0.05

lut_pt_axis = np.linspace(
    0.15,
    3.0,
    5000
)

pion_lut = stable_blast_wave_model(
    lut_pt_axis,
    1.0,
    cern_T_target,
    cern_beta_target,
    m_pion
)

proton_lut = stable_blast_wave_model(
    lut_pt_axis,
    1.0,
    cern_T_target,
    cern_beta_target,
    m_proton
)


def run_rejection_sampling(
    total_tracks,
    lut_weights
):
    simulated = []

    chunk_size = int(
        total_tracks * 1.5
    )

    max_value = np.max(
        lut_weights
    )

    while len(simulated) < total_tracks:

        candidate_pt = np.random.uniform(
            0.15,
            3.0,
            chunk_size
        )

        candidate_prob = np.random.uniform(
            0.0,
            max_value,
            chunk_size
        )

        interpolated_weights = np.exp(
            np.interp(
                candidate_pt,
                lut_pt_axis,
                np.log(lut_weights)
            )
        )

        accepted = candidate_pt[
            candidate_prob < interpolated_weights
        ]

        simulated.extend(
            accepted
        )

    return np.array(
        simulated[:total_tracks]
    )


pion_pt_pool = run_rejection_sampling(
    total_pions,
    pion_lut
)

proton_pt_pool = run_rejection_sampling(
    total_protons,
    proton_lut
)


# —————————————————————————————————————————————————————————————
# SECTION 4
# BIN THE MONTE CARLO DATA
# —————————————————————————————————————————————————————————————

pion_counts, _ = np.histogram(
    pion_pt_pool,
    bins=bin_edges
)

proton_counts, _ = np.histogram(
    proton_pt_pool,
    bins=bin_edges
)

pion_dN_dpt = (
    pion_counts / bin_width
)

proton_dN_dpt = (
    proton_counts / bin_width
)

pion_y_errors = (
    np.sqrt(pion_counts)
    / bin_width
)

proton_y_errors = (
    np.sqrt(proton_counts)
    / bin_width
)


# —————————————————————————————————————————————————————————————
# SECTION 5
# GLOBAL TWO-SPECIES FIT
# —————————————————————————————————————————————————————————————

fit_mask = (
    (bin_centers > 0.4)
    & (bin_centers < 2.2)
)

pt_fit_shared = (
    bin_centers[fit_mask]
)

master_pt_input = np.concatenate([
    pt_fit_shared,
    pt_fit_shared
])

master_log_yield_data = np.concatenate([
    np.log(
        pion_dN_dpt[fit_mask]
    ),
    np.log(
        proton_dN_dpt[fit_mask]
    )
])

master_errors = np.concatenate([
    (
        pion_y_errors[fit_mask]
        / pion_dN_dpt[fit_mask]
    ),
    (
        proton_y_errors[fit_mask]
        / proton_dN_dpt[fit_mask]
    )
])


popt, pcov = curve_fit(
    global_blast_wave_fit,
    master_pt_input,
    master_log_yield_data,
    p0=[
        np.log(2e7),
        np.log(2e6),
        0.105,
        0.64
    ],
    sigma=master_errors,
    absolute_sigma=True,
    method="lm"
)

fit_log_N0_pi = popt[0]
fit_log_N0_pr = popt[1]
global_T_kin = popt[2]
global_beta_s = popt[3]

fit_N0_pi = np.exp(
    fit_log_N0_pi
)

fit_N0_pr = np.exp(
    fit_log_N0_pr
)

master_pred = global_blast_wave_fit(
    master_pt_input,
    *popt
)

global_chi2 = np.sum(
    (
        (
            master_log_yield_data
            - master_pred
        )
        / master_errors
    ) ** 2
)

global_ndf = (
    len(master_pt_input)
    - len(popt)
)

global_chi2_ndf = (
    global_chi2
    / global_ndf
)

global_avg_beta = (
    2.0 / 3.0
) * global_beta_s

target_avg_beta = (
    2.0 / 3.0
) * cern_beta_target


# —————————————————————————————————————————————————————————————
# SECTION 6
# PLOT ASSUMED EXPERIMENTAL AND MONTE CARLO RESULTS
# —————————————————————————————————————————————————————————————

pt_continuous = np.linspace(
    0.15,
    2.75,
    200
)

assumed_fit_curve = stable_blast_wave_model(
    pt_continuous,
    assumed_N0,
    assumed_T_kin,
    assumed_beta_s,
    m_pion
)

pion_fit_curve = stable_blast_wave_model(
    pt_continuous,
    fit_N0_pi,
    global_T_kin,
    global_beta_s,
    m_pion
)

proton_fit_curve = stable_blast_wave_model(
    pt_continuous,
    fit_N0_pr,
    global_T_kin,
    global_beta_s,
    m_proton
)


fig, axes = plt.subplots(
    2,
    2,
    figsize=(14, 10)
)


ax = axes[0, 0]

ax.errorbar(
    assumed_bin_centers,
    assumed_dN_dpt,
    yerr=assumed_total_errors,
    fmt="o",
    markersize=4,
    capsize=2,
    label="Assumed experimental spectrum"
)

ax.plot(
    pt_continuous,
    assumed_fit_curve,
    linewidth=2,
    label=(
        f"Blast-Wave fit: "
        f"T = {assumed_T_kin * 1000:.1f} MeV"
    )
)

ax.set_yscale("log")

ax.set_xlabel(
    r"$p_T$ [GeV/$c$]"
)

ax.set_ylabel(
    r"$dN/dp_T$"
)

ax.set_title(
    "ALICE Pb-Pb Reference Spectrum"
)

ax.legend()

ax.grid(
    True,
    which="both",
    alpha=0.3
)

ax = axes[0, 1]

ax.errorbar(
    bin_centers,
    pion_dN_dpt,
    yerr=pion_y_errors,
    fmt="o",
    markersize=4,
    capsize=2,
    label="Simulated pions"
)

ax.plot(
    pt_continuous,
    pion_fit_curve,
    linewidth=2,
    label=(
        f"Global fit: "
        f"T = {global_T_kin * 1000:.1f} MeV"
    )
)

ax.errorbar(
    bin_centers,
    proton_dN_dpt,
    yerr=proton_y_errors,
    fmt="^",
    markersize=4,
    capsize=2,
    alpha=0.7,
    label="Simulated protons"
)

ax.plot(
    pt_continuous,
    proton_fit_curve,
    linestyle="--",
    linewidth=2,
    label="Global proton fit"
)

ax.set_yscale("log")

ax.set_xlabel(
    r"$p_T$ [GeV/$c$]"
)

ax.set_ylabel(
    r"$dN/dp_T$"
)

ax.set_title(
    "Dual-Species Monte Carlo"
)

ax.legend()

ax.grid(
    True,
    which="both",
    alpha=0.3
)


full_pi_pred = stable_blast_wave_model(
    bin_centers,
    fit_N0_pi,
    global_T_kin,
    global_beta_s,
    m_pion
)

full_pr_pred = stable_blast_wave_model(
    bin_centers,
    fit_N0_pr,
    global_T_kin,
    global_beta_s,
    m_proton
)

pi_residuals = (
    pion_dN_dpt
    - full_pi_pred
) / pion_y_errors

pr_residuals = (
    proton_dN_dpt
    - full_pr_pred
) / proton_y_errors


ax = axes[1, 0]

ax.errorbar(
    bin_centers,
    pi_residuals,
    yerr=np.ones_like(
        bin_centers
    ),
    fmt="o",
    markersize=4,
    capsize=2,
    label="Pion residuals"
)

ax.errorbar(
    bin_centers,
    pr_residuals,
    yerr=np.ones_like(
        bin_centers
    ),
    fmt="^",
    markersize=4,
    capsize=2,
    alpha=0.6,
    label="Proton residuals"
)

ax.axhline(
    0,
    linestyle="--",
    linewidth=1
)

ax.axhspan(
    -2,
    2,
    alpha=0.15
)

ax.set_xlabel(
    r"$p_T$ [GeV/$c$]"
)

ax.set_ylabel(
    r"Residual ($\Delta/\sigma$)"
)

ax.set_title(
    "Global Monte Carlo Residuals"
)

ax.set_ylim(
    -5,
    5
)

ax.legend()

ax.grid(
    True,
    alpha=0.3
)


ax = axes[1, 1]

comparison_text = (
    f"Assumed experimental spectrum\n"
    f"T = {assumed_T_kin * 1000:.2f} MeV\n"
    f"<β> = {assumed_avg_beta:.4f} c\n"
    f"χ²/ndf = {assumed_chi2_ndf:.3f}\n\n"

    f"Global Monte Carlo fit\n"
    f"T = {global_T_kin * 1000:.2f} MeV\n"
    f"<β> = {global_avg_beta:.4f} c\n"
    f"χ²/ndf = {global_chi2_ndf:.3f}\n\n"

    f"Target values\n"
    f"T = {cern_T_target * 1000:.2f} MeV\n"
    f"<β> = {target_avg_beta:.4f} c"
)

ax.text(
    0.05,
    0.95,
    comparison_text,
    transform=ax.transAxes,
    verticalalignment="top",
    fontsize=12
)

ax.axis("off")

ax.set_title(
    "Fit Comparison"
)


plt.tight_layout()

plt.savefig(
    "heavy_ion_blast_wave_comparison.png",
    dpi=300
)

plt.show()


# —————————————————————————————————————————————————————————————
# SECTION 7
# MONTE CARLO FIT
# —————————————————————————————————————————————————————————————

pt_export_axis = np.linspace(
    0.15,
    2.75,
    len(bin_centers)
)

pi_fit_line = stable_blast_wave_model(
    pt_export_axis,
    fit_N0_pi,
    global_T_kin,
    global_beta_s,
    m_pion
)

pr_fit_line = stable_blast_wave_model(
    pt_export_axis,
    fit_N0_pr,
    global_T_kin,
    global_beta_s,
    m_proton
)


output_filename = (
    "heavy_ion_pion_proton_global_fit.csv"
)

with open(
    output_filename,
    "w",
    newline=""
) as f:

    writer = csv.writer(f)

    writer.writerow([
        "pt_bin_center",
        "pion_dN_dpt",
        "pion_error",
        "proton_dN_dpt",
        "proton_error",
        "continuous_pt",
        "pion_fit_curve",
        "proton_fit_curve"
    ])

    for i in range(
        len(bin_centers)
    ):

        writer.writerow([
            f"{bin_centers[i]:.3f}",
            f"{pion_dN_dpt[i]:.2f}",
            f"{pion_y_errors[i]:.2f}",
            f"{proton_dN_dpt[i]:.2f}",
            f"{proton_y_errors[i]:.2f}",
            f"{pt_export_axis[i]:.3f}",
            f"{pi_fit_line[i]:.2f}",
            f"{pr_fit_line[i]:.2f}"
        ])


